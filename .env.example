# SunTrace Environment Configuration
# Copy this to .env.local and fill in your values

# ============================================
# Supabase Configuration (Required)
# ============================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# For Expo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Event Capture Configuration
# ============================================
REACT_APP_EVENT_BATCH_SIZE=50
REACT_APP_EVENT_BATCH_WAIT_MS=5000
REACT_APP_SESSION_TIMEOUT_MS=1800000
REACT_APP_EVENT_DEDUP_WINDOW_MS=60000

# ============================================
# Attribution Configuration
# ============================================
REACT_APP_ATTRIBUTION_WINDOW_DAYS=30
REACT_APP_DEFAULT_ATTRIBUTION_MODEL=last_touch

# ============================================
# Logging Configuration
# ============================================
REACT_APP_LOG_LEVEL=info

# ============================================
# Data Retention Configuration
# ============================================
REACT_APP_EVENT_RETENTION_DAYS=90

# ============================================
# Feature Flags
# ============================================
REACT_APP_ENABLE_REALTIME_ANALYTICS=false
REACT_APP_ENABLE_GDPR=true
REACT_APP_ENABLE_PRIVACY_MODE=false

# ============================================
# API Configuration
# ============================================
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_API_TIMEOUT_MS=30000

# ============================================
# Rate Limiting Configuration
# ============================================
REACT_APP_RATE_LIMIT_WINDOW_MS=60000
REACT_APP_RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Security Configuration
# ============================================
REACT_APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REACT_APP_JWT_SECRET=your-jwt-secret-key-here
