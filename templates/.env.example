# SunTrace — Environment Variables
# Copy this file to .env.local and fill in your real values.
# Never commit secrets to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── RevenueCat (iOS in-app purchases) ─────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_KEY=appl_...
REVENUECAT_WEBHOOK_SECRET=whsec_...

# ── Claude API (AI Coach feature) ─────────────────────────────────────────────
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...

# ── App Config ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_DEV_MODE=false
EXPO_PUBLIC_API_URL=https://your-project.vercel.app

# ── Mapbox (Sun Map feature) ──────────────────────────────────────────────────
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Vercel / server-side only (not exposed to the client) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
REVENUECAT_PUBLIC_KEY=appl_...
