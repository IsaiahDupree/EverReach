# PulseLense — Environment Variables
# Copy to .env and fill in real values. Never commit secrets.

# ── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://utasetfxiqcrnwyfforx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<your-supabase-anon-key>

# ── Backend API ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://ever-reach-be.vercel.app

# ── RevenueCat (subscriptions) ────────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_KEY=<appl_or_goog_...>

# ── App mode ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_DEV_MODE=false

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Meta Pixel (Conversions API) ──────────────────────────────────────────────
EXPO_PUBLIC_META_PIXEL_ID=1191876055285693
EXPO_PUBLIC_META_CONVERSIONS_API_TOKEN=<your-conversions-api-token>
EXPO_PUBLIC_META_TEST_EVENT_CODE=TEST6473
META_CONVERSIONS_ACCESS_TOKEN=<your-conversions-api-token>
