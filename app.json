{
  "expo": {
    "name": "AI-Enhanced Personal CRM",
    "slug": "ai-enhanced-personal-crm",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everreach",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "jsEngine": "jsc",
      "supportsTablet": true,
      "bundleIdentifier": "com.everreach.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EverReach uses your microphone to record voice notes about your contacts. For example, you can say 'Remind me to follow up with Sarah about the project meeting' and it will be transcribed and saved. Your audio is processed securely and only used for transcription.",
        "NSPhotoLibraryUsageDescription": "EverReach needs photo access to let you add profile pictures and share images with your contacts.",
        "NSCameraUsageDescription": "EverReach needs camera access to take photos for contact profiles and capture moments.",
        "NSContactsUsageDescription": "EverReach needs contacts access to import your existing contacts into your personal CRM.",
        "NSUserTrackingUsageDescription": "EverReach uses this to measure advertising effectiveness and personalize your experience. Your data is handled securely.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "telprompt",
          "sms",
          "http",
          "https",
          "fbapi",
          "fb-messenger-share-api",
          "fbauth2",
          "fbshareextension"
        ],
        "SKAdNetworkItems": [
