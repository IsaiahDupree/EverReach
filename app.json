{
  "expo": {
    "name": "SunTrace",
    "slug": "suntrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suntrace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "jsEngine": "jsc",
      "supportsTablet": true,
      "bundleIdentifier": "com.suntrace.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SunTrace uses your location to provide accurate UV readings for your area",
        "NSHealthShareUsageDescription": "SunTrace reads your outdoor activity to correlate with sun exposure",
        "NSHealthUpdateUsageDescription": "SunTrace writes outdoor minutes to Apple Health",
        "NSMicrophoneUsageDescription": "SunTrace uses your microphone to record voice notes about your sun exposure sessions.",
        "NSPhotoLibraryUsageDescription": "SunTrace needs photo access to let you add photos to your sun sessions.",
        "NSCameraUsageDescription": "SunTrace needs camera access to capture photos during your outdoor sessions.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "telprompt",
          "sms",
          "http",
          "https"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.suntrace.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://suntrace.app/"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "SunTrace uses your microphone to record voice notes about your sun exposure sessions."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "SunTrace accesses your photos to let you add images to your sun sessions."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SunTrace uses your location to provide accurate UV readings for your area"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://suntrace.app/"
      },
      "eas": {
        "projectId": "c4c7bc9d-c16c-4a08-bfa4-80abb3ebead4"
      }
    },
    "owner": "isaiahdupree"
  }
}
