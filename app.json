      },
      "usesAppleSignIn": true,
      "accessesContactNotes": true,
      "buildNumber": "3"
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.everreach.crm",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://everreach.app/"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "EverReach uses your microphone to record voice notes about your contacts. For example, you can say 'Remind me to follow up with Sarah' and it will be transcribed and saved."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts to import people into your CRM."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "EverReach uses this identifier to measure ad effectiveness and personalize your experience. Your data is hashed for privacy. You can change this anytime in Settings."
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "453049510987286",
          "clientToken": "3206c77601ed76cd74b6276904c20548",
          "displayName": "EverReach",
          "scheme": "fb453049510987286",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://everreach.app/"
      },
      "eas": {
        "projectId": "c4c7bc9d-c16c-4a08-bfa4-80abb3ebead4"
      }
    },
    "owner": "isaiahdupree"
  }
