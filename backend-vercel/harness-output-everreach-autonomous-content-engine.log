{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01L6JM1aHdJZpxbtXVc8PjTW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DHh8yi8wmtGSjBCbMdz9Ri","name":"mcp__supabase__apply_migration","input":{"name":"ace_content_candidates","query":"-- Content Candidates: post concepts generated from strategy briefs\nCREATE TABLE IF NOT EXISTS content_candidates (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  brief_id UUID REFERENCES content_strategy_briefs(id) ON DELETE SET NULL,\n  pillar TEXT NOT NULL CHECK (pillar IN ('friendship_fade', 'relationship_systems', 'warmth_score', 'outreach_intelligence', 'adult_friendship_psychology', 'product_education', 'proof_and_trust', 'conversion')),\n  subtopic TEXT NOT NULL,\n  awareness_level TEXT NOT NULL CHECK (awareness_level IN ('unaware', 'problem_aware', 'solution_aware', 'product_aware', 'most_aware')),\n  format TEXT NOT NULL CHECK (format IN ('static_truth', 'carousel_psychology', 'carousel_framework', 'product_screenshot', 'founder_note', 'short_reel_concept')),\n  hook_type TEXT NOT NULL CHECK (hook_type IN ('signs', 'mistakes', 'truths', 'why_this_happens', 'tiny_habit', 'realization', 'framework', 'myth_busting')),\n  cta_type TEXT NOT NULL CHECK (cta_type IN ('save_this', 'share_this', 'follow_for_more', 'comment_prompt', 'profile_visit', 'install_app')),\n  target_emotion TEXT,\n  concept_text TEXT NOT NULL,\n  status TEXT NOT NULL DEFAULT 'generated' CHECK (status IN ('generated', 'scored', 'copy_done', 'assets_done', 'approved', 'rejected', 'queued', 'published')),\n  total_score NUMERIC(5,4),\n  predicted_engagement NUMERIC(5,4),\n  predicted_conversion NUMERIC(5,4),\n  novelty_score NUMERIC(5,4),\n  strategic_alignment NUMERIC(5,4),\n  format_strength NUMERIC(5,4),\n  audience_relevance NUMERIC(5,4),\n  production_confidence NUMERIC(5,4),\n  rejection_reason TEXT,\n  metadata JSONB DEFAULT '{}',\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE INDEX idx_content_candidates_brief_id ON content_candidates(brief_id);\nCREATE INDEX idx_content_candidates_status ON content_candidates(status);\nCREATE INDEX idx_content_candidates_score ON content_candidates(total_score DESC NULLS LAST);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2597,"cache_creation_input_tokens":6006,"cache_read_input_tokens":55509,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6006},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"4da838bc-e7fa-45d8-ac70-b18ca48fbbe8"}
