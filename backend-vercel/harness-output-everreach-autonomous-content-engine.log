{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V5emZyEXPyu7iBPc6yDVYw","type":"tool_result","content":"     1→import { createClient, SupabaseClient } from '@supabase/supabase-js';\n     2→\n     3→/**\n     4→ * Create a Supabase client configured for RLS using the caller's Bearer token.\n     5→ * - Uses the anon key so RLS is enforced\n     6→ * - If a Bearer token is present, it will be forwarded in the Authorization header\n     7→ */\n     8→export function createRlsClientFromRequest(req: Request): SupabaseClient | null {\n     9→  const supabaseUrl = process.env.SUPABASE_URL;\n    10→  const anonKey = process.env.SUPABASE_ANON_KEY;\n    11→  if (!supabaseUrl || !anonKey) return null;\n    12→\n    13→  const auth = req.headers.get('authorization') || req.headers.get('Authorization') || '';\n    14→  const [scheme, token] = auth.split(' ');\n    15→  const bearer = scheme?.toLowerCase() === 'bearer' && token ? token : undefined;\n    16→\n    17→  const client = createClient(supabaseUrl, anonKey, {\n    18→    auth: { persistSession: false, detectSessionInUrl: false },\n    19→    db: {\n    20→      schema: 'public'\n    21→    },\n    22→    global: bearer\n    23→      ? { headers: { Authorization: `Bearer ${bearer}` } }\n    24→      : undefined,\n    25→  });\n    26→  return client;\n    27→}\n    28→\n    29→export function getClientOrThrow(req: Request): SupabaseClient {\n    30→  const client = createRlsClientFromRequest(req);\n    31→  if (!client) throw new Error('Server is misconfigured: missing SUPABASE_URL or SUPABASE_ANON_KEY');\n    32→  return client;\n    33→}\n    34→\n    35→/**\n    36→ * Service-role client (bypasses RLS). Use only for admin/cron operations.\n    37→ */\n    38→export function getServiceClient(): SupabaseClient {\n    39→  const supabaseUrl = process.env.SUPABASE_URL;\n    40→  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\n    41→  if (!supabaseUrl || !serviceKey) {\n    42→    throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');\n    43→  }\n    44→  return createClient(supabaseUrl, serviceKey, {\n    45→    auth: { persistSession: false, detectSessionInUrl: false },\n    46→    db: {\n    47→      schema: 'public'\n    48→    }\n    49→  });\n    50→}\n    51→\n    52→/**\n    53→ * Build-safe service client getter. Returns a lazy function that creates\n    54→ * the Supabase client only when actually invoked at runtime.\n    55→ * This prevents build-time errors during Next.js page collection.\n    56→ */\n    57→export function getSupabaseServiceClient() {\n    58→  const url = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL;\n    59→  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;\n    60→\n    61→  // During build time, env vars might not be available. Return a dummy client.\n    62→  // This will fail if actually called, but won't crash the build.\n    63→  if (!url || !key) {\n    64→    // Create a minimal valid URL to satisfy Supabase's validation\n    65→    // This won't work at runtime, but prevents build-time errors\n    66→    return createClient('https://placeholder.supabase.co', 'placeholder-key', {\n    67→      auth: { persistSession: false, detectSessionInUrl: false },\n    68→    });\n    69→  }\n    70→\n    71→  return createClient(url, key, {\n    72→    auth: { persistSession: false, detectSessionInUrl: false },\n    73→    db: {\n    74→      schema: 'public'\n    75→    }\n    76→  });\n    77→}\n    78→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"eb4472d8-2d98-4b2e-984c-a22e7f287505","uuid":"b5289527-ee89-4f1a-86d9-69efff6e287e","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/supabase.ts","content":"import { createClient, SupabaseClient } from '@supabase/supabase-js';\n\n/**\n * Create a Supabase client configured for RLS using the caller's Bearer token.\n * - Uses the anon key so RLS is enforced\n * - If a Bearer token is present, it will be forwarded in the Authorization header\n */\nexport function createRlsClientFromRequest(req: Request): SupabaseClient | null {\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const anonKey = process.env.SUPABASE_ANON_KEY;\n  if (!supabaseUrl || !anonKey) return null;\n\n  const auth = req.headers.get('authorization') || req.headers.get('Authorization') || '';\n  const [scheme, token] = auth.split(' ');\n  const bearer = scheme?.toLowerCase() === 'bearer' && token ? token : undefined;\n\n  const client = createClient(supabaseUrl, anonKey, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    },\n    global: bearer\n      ? { headers: { Authorization: `Bearer ${bearer}` } }\n      : undefined,\n  });\n  return client;\n}\n\nexport function getClientOrThrow(req: Request): SupabaseClient {\n  const client = createRlsClientFromRequest(req);\n  if (!client) throw new Error('Server is misconfigured: missing SUPABASE_URL or SUPABASE_ANON_KEY');\n  return client;\n}\n\n/**\n * Service-role client (bypasses RLS). Use only for admin/cron operations.\n */\nexport function getServiceClient(): SupabaseClient {\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\n  if (!supabaseUrl || !serviceKey) {\n    throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');\n  }\n  return createClient(supabaseUrl, serviceKey, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    }\n  });\n}\n\n/**\n * Build-safe service client getter. Returns a lazy function that creates\n * the Supabase client only when actually invoked at runtime.\n * This prevents build-time errors during Next.js page collection.\n */\nexport function getSupabaseServiceClient() {\n  const url = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL;\n  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;\n\n  // During build time, env vars might not be available. Return a dummy client.\n  // This will fail if actually called, but won't crash the build.\n  if (!url || !key) {\n    // Create a minimal valid URL to satisfy Supabase's validation\n    // This won't work at runtime, but prevents build-time errors\n    return createClient('https://placeholder.supabase.co', 'placeholder-key', {\n      auth: { persistSession: false, detectSessionInUrl: false },\n    });\n  }\n\n  return createClient(url, key, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    }\n  });\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
