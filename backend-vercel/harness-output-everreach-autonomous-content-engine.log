{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017XBFja8c6kH3fvS4F9RmUi","type":"tool_result","content":"     1→/**\n     2→ * Instagram Autonomous Publisher — Cron Job\n     3→ *\n     4→ * Runs every hour. For each user with an enabled publisher config:\n     5→ *   1. Checks if it's time to post (based on learned frequency target).\n     6→ *   2. Picks the best time slot using Thompson Sampling.\n     7→ *   3. Grabs the next queued post.\n     8→ *   4. Publishes via the Instagram Graph API.\n     9→ *   5. Records the post in instagram_post_performance for later feedback.\n    10→ *\n    11→ * Trigger: every hour at :00 UTC\n    12→ * GET /api/cron/instagram-publisher\n    13→ */\n    14→\n    15→import { NextRequest, NextResponse } from 'next/server';\n    16→import { getServiceClient } from '@/lib/supabase';\n    17→import {\n    18→  getOrCreateConfig,\n    19→  pickNextSlot,\n    20→  shouldPostNow,\n    21→  seedPriors,\n    22→} from '@/lib/instagram-scheduler';\n    23→\n    24→const GRAPH_API = 'https://graph.facebook.com/v22.0';\n    25→\n    26→function getToken(): string | undefined {\n    27→  return process.env.INSTAGRAM_ACCESS_TOKEN;\n    28→}\n    29→function getIgUserId(): string | undefined {\n    30→  return process.env.INSTAGRAM_BUSINESS_ACCOUNT_ID;\n    31→}\n    32→\n    33→async function graphPost(path: string, params: Record<string, string>) {\n    34→  const res = await fetch(`${GRAPH_API}${path}`, {\n    35→    method: 'POST',\n    36→    headers: { 'Content-Type': 'application/json' },\n    37→    body: JSON.stringify(params),\n    38→  });\n    39→  const data = await res.json();\n    40→  if (!res.ok) throw new Error(`Graph API (${res.status}): ${data?.error?.message ?? JSON.stringify(data)}`);\n    41→  return data;\n    42→}\n    43→\n    44→async function graphGet(path: string, params: URLSearchParams) {\n    45→  const res = await fetch(`${GRAPH_API}${path}?${params}`);\n    46→  const data = await res.json();\n    47→  if (!res.ok) throw new Error(`Graph API (${res.status}): ${data?.error?.message ?? JSON.stringify(data)}`);\n    48→  return data;\n    49→}\n    50→\n    51→async function waitForContainer(containerId: string, token: string, maxAttempts = 18) {\n    52→  for (let i = 0; i < maxAttempts; i++) {\n    53→    await new Promise(r => setTimeout(r, 5000));\n    54→    const p = new URLSearchParams({ fields: 'status_code', access_token: token });\n    55→    const d = await graphGet(`/${containerId}`, p);\n    56→    if (d.status_code === 'FINISHED') return;\n    57→    if (d.status_code === 'ERROR') throw new Error('Container processing failed');\n    58→  }\n    59→  throw new Error('Container processing timed out');\n    60→}\n    61→\n    62→async function publishPost(\n    63→  post: Record<string, unknown>,\n    64→  token: string,\n    65→  igUserId: string\n    66→): Promise<{ ig_media_id: string; permalink: string | null }> {\n    67→  const params: Record<string, string> = { access_token: token };\n    68→\n    69→  let containerId: string;\n    70→\n    71→  if (post.media_type === 'CAROUSEL_ALBUM') {\n    72→    const children = post.children as Array<{ image_url: string }>;\n    73→    const childIds = await Promise.all(\n    74→      children.map(async c => {\n    75→        const d = await graphPost(`/${igUserId}/media`, {\n    76→          image_url: c.image_url,\n    77→          is_carousel_item: 'true',\n    78→          access_token: token,\n    79→        });\n    80→        return d.id as string;\n    81→      })\n    82→    );\n    83→    const carouselP: Record<string, string> = {\n    84→      media_type: 'CAROUSEL',\n    85→      children: childIds.join(','),\n    86→      access_token: token,\n    87→    };\n    88→    if (post.caption) carouselP.caption = post.caption as string;\n    89→    if (post.location_id) carouselP.location_id = post.location_id as string;\n    90→    containerId = (await graphPost(`/${igUserId}/media`, carouselP)).id;\n    91→\n    92→  } else if (post.media_type === 'REELS') {\n    93→    const p: Record<string, string> = {\n    94→      media_type: 'REELS',\n    95→      video_url: post.video_url as string,\n    96→      share_to_feed: String(post.share_to_feed ?? true),\n    97→      access_token: token,\n    98→    };\n    99→    if (post.caption) p.caption = post.caption as string;\n   100→    if (post.location_id) p.location_id = post.location_id as string;\n   101→    containerId = (await graphPost(`/${igUserId}/media`, p)).id;\n   102→    await waitForContainer(containerId, token);\n   103→\n   104→  } else {\n   105→    // IMAGE or STORIES\n   106→    const p: Record<string, string> = {\n   107→      image_url: post.image_url as string,\n   108→      access_token: token,\n   109→    };\n   110→    if (post.media_type === 'STORIES') p.media_type = 'STORIES';\n   111→    if (post.caption && post.media_type !== 'STORIES') p.caption = post.caption as string;\n   112→    if (post.location_id) p.location_id = post.location_id as string;\n   113→    containerId = (await graphPost(`/${igUserId}/media`, p)).id;\n   114→  }\n   115→\n   116→  const { id: igMediaId } = await graphPost(`/${igUserId}/media_publish`, {\n   117→    creation_id: containerId,\n   118→    ...params,\n   119→  });\n   120→\n   121→  // Fetch permalink\n   122→  let permalink: string | null = null;\n   123→  try {\n   124→    const d = await graphGet(`/${igMediaId}`, new URLSearchParams({ fields: 'permalink', access_token: token }));\n   125→    permalink = d.permalink ?? null;\n   126→  } catch { /* non-fatal */ }\n   127→\n   128→  return { ig_media_id: igMediaId, permalink };\n   129→}\n   130→\n   131→export async function GET(req: NextRequest) {\n   132→  // Verify cron secret\n   133→  const authHeader = req.headers.get('authorization');\n   134→  const cronSecret = process.env.CRON_SECRET;\n   135→  if (cronSecret && authHeader !== `Bearer ${cronSecret}`) {\n   136→    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n   137→  }\n   138→\n   139→  const token = getToken();\n   140→  const igUserId = getIgUserId();\n   141→\n   142→  if (!token || !igUserId) {\n   143→    return NextResponse.json({\n   144→      skipped: true,\n   145→      reason: 'INSTAGRAM_ACCESS_TOKEN or INSTAGRAM_BUSINESS_ACCOUNT_ID not configured',\n   146→    });\n   147→  }\n   148→\n   149→  const supabase = getServiceClient();\n   150→  const now = new Date();\n   151→  const results: Array<{ user_id: string; status: string; detail?: string }> = [];\n   152→\n   153→  // Get all users with enabled publisher configs\n   154→  const { data: configs } = await supabase\n   155→    .from('instagram_publisher_config')\n   156→    .select('*')\n   157→    .eq('enabled', true);\n   158→\n   159→  if (!configs || configs.length === 0) {\n   160→    // Auto-discover users with queued posts and create configs\n   161→    const { data: queuedUsers } = await supabase\n   162→      .from('instagram_post_queue')\n   163→      .select('user_id')\n   164→      .eq('status', 'queued');\n   165→\n   166→    if (!queuedUsers?.length) {\n   167→      return NextResponse.json({ message: 'No queued posts or configs found', processed: 0 });\n   168→    }\n   169→\n   170→    // Create configs for users with queued posts\n   171→    const uniqueUsers = [...new Set(queuedUsers.map(r => r.user_id))];\n   172→    for (const userId of uniqueUsers) {\n   173→      await getOrCreateConfig(supabase, userId);\n   174→    }\n   175→  }\n   176→\n   177→  // Reload configs after possible seeding\n   178→  const { data: allConfigs } = await supabase\n   179→    .from('instagram_publisher_config')\n   180→    .select('*')\n   181→    .eq('enabled', true);\n   182→\n   183→  for (const config of allConfigs ?? []) {\n   184→    try {\n   185→      // Should we post for this user right now?\n   186→      if (!shouldPostNow(config)) {\n   187→        results.push({ user_id: config.user_id, status: 'skipped', detail: 'not_time_yet' });\n   188→        continue;\n   189→      }\n   190→\n   191→      // Check quiet hours\n   192→      const currentHour = now.getUTCHours();\n   193→      const { quiet_start_hour: qs, quiet_end_hour: qe } = config;\n   194→      const inQuiet = qs > qe\n   195→        ? (currentHour >= qs || currentHour < qe)\n   196→        : (currentHour >= qs && currentHour < qe);\n   197→      if (inQuiet) {\n   198→        results.push({ user_id: config.user_id, status: 'skipped', detail: 'quiet_hours' });\n   199→        continue;\n   200→      }\n   201→\n   202→      // Get next queued post for this user (highest priority, oldest first)\n   203→      const { data: post } = await supabase\n   204→        .from('instagram_post_queue')\n   205→        .select('*')\n   206→        .eq('user_id', config.user_id)\n   207→        .in('status', ['queued', 'failed'])\n   208→        .lt('retry_count', 3)\n   209→        .or(`scheduled_at.is.null,scheduled_at.lte.${now.toISOString()}`)\n   210→        .order('priority', { ascending: true })\n   211→        .order('created_at', { ascending: true })\n   212→        .limit(1)\n   213→        .single();\n   214→\n   215→      if (!post) {\n   216→        results.push({ user_id: config.user_id, status: 'skipped', detail: 'no_queued_posts' });\n   217→        continue;\n   218→      }\n   219→\n   220→      // Mark as publishing\n   221→      await supabase\n   222→        .from('instagram_post_queue')\n   223→        .update({ status: 'publishing', updated_at: now.toISOString() })\n   224→        .eq('id', post.id);\n   225→\n   226→      // Publish\n   227→      const { ig_media_id, permalink } = await publishPost(post, token, igUserId);\n   228→\n   229→      const publishedAt = new Date();\n   230→      await supabase\n   231→        .from('instagram_post_queue')\n   232→        .update({\n   233→          status: 'published',\n   234→          ig_media_id,\n   235→          permalink,\n   236→          published_at: publishedAt.toISOString(),\n   237→          updated_at: publishedAt.toISOString(),\n   238→        })\n   239→        .eq('id', post.id);\n   240→\n   241→      // Record in performance table (metrics fetched later by engagement-sync cron)\n   242→      await supabase.from('instagram_post_performance').insert({\n   243→        ig_media_id,\n   244→        queue_id: post.id,\n   245→        user_id: config.user_id,\n   246→        posted_at: publishedAt.toISOString(),\n   247→        hour_of_day: publishedAt.getUTCHours(),\n   248→        day_of_week: publishedAt.getUTCDay(),\n   249→        media_type: post.media_type,\n   250→      });\n   251→\n   252→      // Update last_posted_at + posts_last_7d\n   253→      await supabase\n   254→        .from('instagram_publisher_config')\n   255→        .update({\n   256→          last_posted_at: publishedAt.toISOString(),\n   257→          posts_last_7d: config.posts_last_7d + 1,\n   258→          updated_at: publishedAt.toISOString(),\n   259→        })\n   260→        .eq('user_id', config.user_id);\n   261→\n   262→      results.push({\n   263→        user_id: config.user_id,\n   264→        status: 'published',\n   265→        detail: `ig_media_id=${ig_media_id}${permalink ? `, url=${permalink}` : ''}`,\n   266→      });\n   267→\n   268→    } catch (err) {\n   269→      const msg = (err as Error).message;\n   270→      console.error(`[instagram-publisher] Error for user ${config.user_id}:`, msg);\n   271→\n   272→      // Find the publishing post and mark as failed\n   273→      const { data: failedPost } = await supabase\n   274→        .from('instagram_post_queue')\n   275→        .select('id, retry_count')\n   276→        .eq('user_id', config.user_id)\n   277→        .eq('status', 'publishing')\n   278→        .single();\n   279→\n   280→      if (failedPost) {\n   281→        const nextRetry = new Date(Date.now() + Math.pow(2, failedPost.retry_count) * 60 * 60 * 1000);\n   282→        await supabase\n   283→          .from('instagram_post_queue')\n   284→          .update({\n   285→            status: 'failed',\n   286→            error: msg,\n   287→            retry_count: failedPost.retry_count + 1,\n   288→            next_retry_at: nextRetry.toISOString(),\n   289→            updated_at: new Date().toISOString(),\n   290→          })\n   291→          .eq('id', failedPost.id);\n   292→      }\n   293→\n   294→      results.push({ user_id: config.user_id, status: 'error', detail: msg });\n   295→    }\n   296→  }\n   297→\n   298→  const published = results.filter(r => r.status === 'published').length;\n   299→  const skipped = results.filter(r => r.status === 'skipped').length;\n   300→  const errors = results.filter(r => r.status === 'error').length;\n   301→\n   302→  return NextResponse.json({\n   303→    message: `Instagram publisher complete`,\n   304→    published,\n   305→    skipped,\n   306→    errors,\n   307→    results,\n   308→    ran_at: now.toISOString(),\n   309→  });\n   310→}\n   311→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"cf96e788-e534-4763-93c5-06eed59ea89a","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/cron/instagram-publisher/route.ts","content":"/**\n * Instagram Autonomous Publisher — Cron Job\n *\n * Runs every hour. For each user with an enabled publisher config:\n *   1. Checks if it's time to post (based on learned frequency target).\n *   2. Picks the best time slot using Thompson Sampling.\n *   3. Grabs the next queued post.\n *   4. Publishes via the Instagram Graph API.\n *   5. Records the post in instagram_post_performance for later feedback.\n *\n * Trigger: every hour at :00 UTC\n * GET /api/cron/instagram-publisher\n */\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport { getServiceClient } from '@/lib/supabase';\nimport {\n  getOrCreateConfig,\n  pickNextSlot,\n  shouldPostNow,\n  seedPriors,\n} from '@/lib/instagram-scheduler';\n\nconst GRAPH_API = 'https://graph.facebook.com/v22.0';\n\nfunction getToken(): string | undefined {\n  return process.env.INSTAGRAM_ACCESS_TOKEN;\n}\nfunction getIgUserId(): string | undefined {\n  return process.env.INSTAGRAM_BUSINESS_ACCOUNT_ID;\n}\n\nasync function graphPost(path: string, params: Record<string, string>) {\n  const res = await fetch(`${GRAPH_API}${path}`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(params),\n  });\n  const data = await res.json();\n  if (!res.ok) throw new Error(`Graph API (${res.status}): ${data?.error?.message ?? JSON.stringify(data)}`);\n  return data;\n}\n\nasync function graphGet(path: string, params: URLSearchParams) {\n  const res = await fetch(`${GRAPH_API}${path}?${params}`);\n  const data = await res.json();\n  if (!res.ok) throw new Error(`Graph API (${res.status}): ${data?.error?.message ?? JSON.stringify(data)}`);\n  return data;\n}\n\nasync function waitForContainer(containerId: string, token: string, maxAttempts = 18) {\n  for (let i = 0; i < maxAttempts; i++) {\n    await new Promise(r => setTimeout(r, 5000));\n    const p = new URLSearchParams({ fields: 'status_code', access_token: token });\n    const d = await graphGet(`/${containerId}`, p);\n    if (d.status_code === 'FINISHED') return;\n    if (d.status_code === 'ERROR') throw new Error('Container processing failed');\n  }\n  throw new Error('Container processing timed out');\n}\n\nasync function publishPost(\n  post: Record<string, unknown>,\n  token: string,\n  igUserId: string\n): Promise<{ ig_media_id: string; permalink: string | null }> {\n  const params: Record<string, string> = { access_token: token };\n\n  let containerId: string;\n\n  if (post.media_type === 'CAROUSEL_ALBUM') {\n    const children = post.children as Array<{ image_url: string }>;\n    const childIds = await Promise.all(\n      children.map(async c => {\n        const d = await graphPost(`/${igUserId}/media`, {\n          image_url: c.image_url,\n          is_carousel_item: 'true',\n          access_token: token,\n        });\n        return d.id as string;\n      })\n    );\n    const carouselP: Record<string, string> = {\n      media_type: 'CAROUSEL',\n      children: childIds.join(','),\n      access_token: token,\n    };\n    if (post.caption) carouselP.caption = post.caption as string;\n    if (post.location_id) carouselP.location_id = post.location_id as string;\n    containerId = (await graphPost(`/${igUserId}/media`, carouselP)).id;\n\n  } else if (post.media_type === 'REELS') {\n    const p: Record<string, string> = {\n      media_type: 'REELS',\n      video_url: post.video_url as string,\n      share_to_feed: String(post.share_to_feed ?? true),\n      access_token: token,\n    };\n    if (post.caption) p.caption = post.caption as string;\n    if (post.location_id) p.location_id = post.location_id as string;\n    containerId = (await graphPost(`/${igUserId}/media`, p)).id;\n    await waitForContainer(containerId, token);\n\n  } else {\n    // IMAGE or STORIES\n    const p: Record<string, string> = {\n      image_url: post.image_url as string,\n      access_token: token,\n    };\n    if (post.media_type === 'STORIES') p.media_type = 'STORIES';\n    if (post.caption && post.media_type !== 'STORIES') p.caption = post.caption as string;\n    if (post.location_id) p.location_id = post.location_id as string;\n    containerId = (await graphPost(`/${igUserId}/media`, p)).id;\n  }\n\n  const { id: igMediaId } = await graphPost(`/${igUserId}/media_publish`, {\n    creation_id: containerId,\n    ...params,\n  });\n\n  // Fetch permalink\n  let permalink: string | null = null;\n  try {\n    const d = await graphGet(`/${igMediaId}`, new URLSearchParams({ fields: 'permalink', access_token: token }));\n    permalink = d.permalink ?? null;\n  } catch { /* non-fatal */ }\n\n  return { ig_media_id: igMediaId, permalink };\n}\n\nexport async function GET(req: NextRequest) {\n  // Verify cron secret\n  const authHeader = req.headers.get('authorization');\n  const cronSecret = process.env.CRON_SECRET;\n  if (cronSecret && authHeader !== `Bearer ${cronSecret}`) {\n    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });\n  }\n\n  const token = getToken();\n  const igUserId = getIgUserId();\n\n  if (!token || !igUserId) {\n    return NextResponse.json({\n      skipped: true,\n      reason: 'INSTAGRAM_ACCESS_TOKEN or INSTAGRAM_BUSINESS_ACCOUNT_ID not configured',\n    });\n  }\n\n  const supabase = getServiceClient();\n  const now = new Date();\n  const results: Array<{ user_id: string; status: string; detail?: string }> = [];\n\n  // Get all users with enabled publisher configs\n  const { data: configs } = await supabase\n    .from('instagram_publisher_config')\n    .select('*')\n    .eq('enabled', true);\n\n  if (!configs || configs.length === 0) {\n    // Auto-discover users with queued posts and create configs\n    const { data: queuedUsers } = await supabase\n      .from('instagram_post_queue')\n      .select('user_id')\n      .eq('status', 'queued');\n\n    if (!queuedUsers?.length) {\n      return NextResponse.json({ message: 'No queued posts or configs found', processed: 0 });\n    }\n\n    // Create configs for users with queued posts\n    const uniqueUsers = [...new Set(queuedUsers.map(r => r.user_id))];\n    for (const userId of uniqueUsers) {\n      await getOrCreateConfig(supabase, userId);\n    }\n  }\n\n  // Reload configs after possible seeding\n  const { data: allConfigs } = await supabase\n    .from('instagram_publisher_config')\n    .select('*')\n    .eq('enabled', true);\n\n  for (const config of allConfigs ?? []) {\n    try {\n      // Should we post for this user right now?\n      if (!shouldPostNow(config)) {\n        results.push({ user_id: config.user_id, status: 'skipped', detail: 'not_time_yet' });\n        continue;\n      }\n\n      // Check quiet hours\n      const currentHour = now.getUTCHours();\n      const { quiet_start_hour: qs, quiet_end_hour: qe } = config;\n      const inQuiet = qs > qe\n        ? (currentHour >= qs || currentHour < qe)\n        : (currentHour >= qs && currentHour < qe);\n      if (inQuiet) {\n        results.push({ user_id: config.user_id, status: 'skipped', detail: 'quiet_hours' });\n        continue;\n      }\n\n      // Get next queued post for this user (highest priority, oldest first)\n      const { data: post } = await supabase\n        .from('instagram_post_queue')\n        .select('*')\n        .eq('user_id', config.user_id)\n        .in('status', ['queued', 'failed'])\n        .lt('retry_count', 3)\n        .or(`scheduled_at.is.null,scheduled_at.lte.${now.toISOString()}`)\n        .order('priority', { ascending: true })\n        .order('created_at', { ascending: true })\n        .limit(1)\n        .single();\n\n      if (!post) {\n        results.push({ user_id: config.user_id, status: 'skipped', detail: 'no_queued_posts' });\n        continue;\n      }\n\n      // Mark as publishing\n      await supabase\n        .from('instagram_post_queue')\n        .update({ status: 'publishing', updated_at: now.toISOString() })\n        .eq('id', post.id);\n\n      // Publish\n      const { ig_media_id, permalink } = await publishPost(post, token, igUserId);\n\n      const publishedAt = new Date();\n      await supabase\n        .from('instagram_post_queue')\n        .update({\n          status: 'published',\n          ig_media_id,\n          permalink,\n          published_at: publishedAt.toISOString(),\n          updated_at: publishedAt.toISOString(),\n        })\n        .eq('id', post.id);\n\n      // Record in performance table (metrics fetched later by engagement-sync cron)\n      await supabase.from('instagram_post_performance').insert({\n        ig_media_id,\n        queue_id: post.id,\n        user_id: config.user_id,\n        posted_at: publishedAt.toISOString(),\n        hour_of_day: publishedAt.getUTCHours(),\n        day_of_week: publishedAt.getUTCDay(),\n        media_type: post.media_type,\n      });\n\n      // Update last_posted_at + posts_last_7d\n      await supabase\n        .from('instagram_publisher_config')\n        .update({\n          last_posted_at: publishedAt.toISOString(),\n          posts_last_7d: config.posts_last_7d + 1,\n          updated_at: publishedAt.toISOString(),\n        })\n        .eq('user_id', config.user_id);\n\n      results.push({\n        user_id: config.user_id,\n        status: 'published',\n        detail: `ig_media_id=${ig_media_id}${permalink ? `, url=${permalink}` : ''}`,\n      });\n\n    } catch (err) {\n      const msg = (err as Error).message;\n      console.error(`[instagram-publisher] Error for user ${config.user_id}:`, msg);\n\n      // Find the publishing post and mark as failed\n      const { data: failedPost } = await supabase\n        .from('instagram_post_queue')\n        .select('id, retry_count')\n        .eq('user_id', config.user_id)\n        .eq('status', 'publishing')\n        .single();\n\n      if (failedPost) {\n        const nextRetry = new Date(Date.now() + Math.pow(2, failedPost.retry_count) * 60 * 60 * 1000);\n        await supabase\n          .from('instagram_post_queue')\n          .update({\n            status: 'failed',\n            error: msg,\n            retry_count: failedPost.retry_count + 1,\n            next_retry_at: nextRetry.toISOString(),\n            updated_at: new Date().toISOString(),\n          })\n          .eq('id', failedPost.id);\n      }\n\n      results.push({ user_id: config.user_id, status: 'error', detail: msg });\n    }\n  }\n\n  const published = results.filter(r => r.status === 'published').length;\n  const skipped = results.filter(r => r.status === 'skipped').length;\n  const errors = results.filter(r => r.status === 'error').length;\n\n  return NextResponse.json({\n    message: `Instagram publisher complete`,\n    published,\n    skipped,\n    errors,\n    results,\n    ran_at: now.toISOString(),\n  });\n}\n","numLines":311,"startLine":1,"totalLines":311}}}
