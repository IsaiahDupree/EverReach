{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bd42ks9tMArhVAUAX7waLU","type":"tool_result","content":"The file /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/v1/content/health/route.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"eb4472d8-2d98-4b2e-984c-a22e7f287505","uuid":"5855d3b8-cbf1-4aa2-8f8c-962ae8002811","tool_use_result":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/v1/content/health/route.ts","oldString":"    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }\n\n    // 3. Check active model weights\n    const { data: activeWeights, error: weightsErr } = await supabase\n      .from('model_weights')\n      .select('id')\n      .eq('is_active', true)\n      .limit(1);\n\n    const hasWeights = !weightsErr && activeWeights && activeWeights.length > 0;\n    if (weightsErr) {\n      console.error('Model weights query error:', weightsErr);\n      issues.push(`Model weights query failed: ${weightsErr.message}`);\n    } else if (!hasWeights) {\n      console.warn('No active model weights found');\n      issues.push('No active model_weights found');\n    }","newString":"    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }","originalFile":"/**\n * Content Engine Health Endpoint\n * GET /api/v1/content/health\n *\n * Checks: Supabase connectivity, OpenAI API key, content_templates count,\n * active model_weights exists\n */\n\nimport { NextResponse } from 'next/server';\nimport { getServiceClient } from '@/lib/supabase';\n\nexport const runtime = 'nodejs';\n\nexport async function GET() {\n  try {\n    let supabase;\n    try {\n      supabase = getServiceClient();\n    } catch (e) {\n      console.error('Failed to initialize Supabase service client:', e);\n      return NextResponse.json(\n        {\n          ok: false,\n          error: String(e),\n          issues: ['Failed to initialize Supabase service client'],\n        },\n        { status: 503 }\n      );\n    }\n\n    const issues = [];\n\n    // 1. Check Supabase connectivity and templates using stored function\n    const { data: healthData, error: healthErr } = await supabase\n      .rpc('get_content_health');\n\n    let templateCount = 0;\n    let hasWeights = false;\n    if (healthErr) {\n      console.error('Health function error:', healthErr);\n      issues.push(`Health check failed: ${healthErr.message}`);\n    } else if (healthData) {\n      templateCount = healthData.templates_count || 0;\n      hasWeights = healthData.weights_count > 0;\n      if (templateCount === 0) {\n        issues.push('No templates found');\n      }\n      if (!hasWeights) {\n        issues.push('No active model_weights found');\n      }\n    } else {\n      issues.push('Health check returned no data');\n    }\n\n    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }\n\n    // 3. Check active model weights\n    const { data: activeWeights, error: weightsErr } = await supabase\n      .from('model_weights')\n      .select('id')\n      .eq('is_active', true)\n      .limit(1);\n\n    const hasWeights = !weightsErr && activeWeights && activeWeights.length > 0;\n    if (weightsErr) {\n      console.error('Model weights query error:', weightsErr);\n      issues.push(`Model weights query failed: ${weightsErr.message}`);\n    } else if (!hasWeights) {\n      console.warn('No active model weights found');\n      issues.push('No active model_weights found');\n    }\n\n    const isHealthy = issues.length === 0;\n\n    return NextResponse.json(\n      {\n        ok: isHealthy,\n        supabase: 'connected',\n        openai_key: apiKey ? 'present' : 'missing',\n        templates: templateCount,\n        model_weights: hasWeights ? 'active' : 'missing',\n        issues: issues.length > 0 ? issues : undefined,\n      },\n      { status: isHealthy ? 200 : 503 }\n    );\n  } catch (error) {\n    console.error('Health check failed:', error);\n    return NextResponse.json(\n      { ok: false, error: String(error), issues: ['Unexpected error during health check'] },\n      { status: 503 }\n    );\n  }\n}\n","structuredPatch":[{"oldStart":58,"oldLines":22,"newStart":58,"newLines":6,"lines":["       issues.push('OPENAI_API_KEY not configured');","     }"," ","-    // 3. Check active model weights","-    const { data: activeWeights, error: weightsErr } = await supabase","-      .from('model_weights')","-      .select('id')","-      .eq('is_active', true)","-      .limit(1);","-","-    const hasWeights = !weightsErr && activeWeights && activeWeights.length > 0;","-    if (weightsErr) {","-      console.error('Model weights query error:', weightsErr);","-      issues.push(`Model weights query failed: ${weightsErr.message}`);","-    } else if (!hasWeights) {","-      console.warn('No active model weights found');","-      issues.push('No active model_weights found');","-    }","-","     const isHealthy = issues.length === 0;"," ","     return NextResponse.json("]}],"userModified":false,"replaceAll":false}}
