{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XQM9NxqzAr4P2gSbpRb2i9","type":"tool_result","content":"     1→import { createClient, SupabaseClient } from '@supabase/supabase-js';\n     2→\n     3→/**\n     4→ * Create a Supabase client configured for RLS using the caller's Bearer token.\n     5→ * - Uses the anon key so RLS is enforced\n     6→ * - If a Bearer token is present, it will be forwarded in the Authorization header\n     7→ */\n     8→export function createRlsClientFromRequest(req: Request): SupabaseClient | null {\n     9→  const supabaseUrl = process.env.SUPABASE_URL;\n    10→  const anonKey = process.env.SUPABASE_ANON_KEY;\n    11→  if (!supabaseUrl || !anonKey) return null;\n    12→\n    13→  const auth = req.headers.get('authorization') || req.headers.get('Authorization') || '';\n    14→  const [scheme, token] = auth.split(' ');\n    15→  const bearer = scheme?.toLowerCase() === 'bearer' && token ? token : undefined;\n    16→\n    17→  const client = createClient(supabaseUrl, anonKey, {\n    18→    auth: { persistSession: false, detectSessionInUrl: false },\n    19→    db: {\n    20→      schema: 'public'\n    21→    },\n    22→    global: bearer\n    23→      ? { headers: { Authorization: `Bearer ${bearer}` } }\n    24→      : undefined,\n    25→  });\n    26→  return client;\n    27→}\n    28→\n    29→export function getClientOrThrow(req: Request): SupabaseClient {\n    30→  const client = createRlsClientFromRequest(req);\n    31→  if (!client) throw new Error('Server is misconfigured: missing SUPABASE_URL or SUPABASE_ANON_KEY');\n    32→  return client;\n    33→}\n    34→\n    35→/**\n    36→ * Service-role client (bypasses RLS). Use only for admin/cron operations.\n    37→ */\n    38→export function getServiceClient(): SupabaseClient {\n    39→  const supabaseUrl = process.env.SUPABASE_URL;\n    40→  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\n    41→  if (!supabaseUrl || !serviceKey) {\n    42→    throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');\n    43→  }\n    44→  return createClient(supabaseUrl, serviceKey, {\n    45→    auth: { persistSession: false, detectSessionInUrl: false },\n    46→    db: {\n    47→      schema: 'public'\n    48→    }\n    49→  });\n    50→}\n    51→\n    52→/**\n    53→ * Build-safe service client getter. Returns a lazy function that creates\n    54→ * the Supabase client only when actually invoked at runtime.\n    55→ * This prevents build-time errors during Next.js page collection.\n    56→ */\n    57→export function getSupabaseServiceClient() {\n    58→  const url = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL;\n    59→  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;\n    60→\n    61→  // During build time, env vars might not be available. Return a dummy client.\n    62→  // This will fail if actually called, but won't crash the build.\n    63→  if (!url || !key) {\n    64→    // Create a minimal valid URL to satisfy Supabase's validation\n    65→    // This won't work at runtime, but prevents build-time errors\n    66→    return createClient('https://placeholder.supabase.co', 'placeholder-key', {\n    67→      auth: { persistSession: false, detectSessionInUrl: false },\n    68→    });\n    69→  }\n    70→\n    71→  return createClient(url, key, {\n    72→    auth: { persistSession: false, detectSessionInUrl: false },\n    73→    db: {\n    74→      schema: 'public'\n    75→    }\n    76→  });\n    77→}\n    78→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"17c156eb-2452-46a2-ace3-d71deaa18a91","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/supabase.ts","content":"import { createClient, SupabaseClient } from '@supabase/supabase-js';\n\n/**\n * Create a Supabase client configured for RLS using the caller's Bearer token.\n * - Uses the anon key so RLS is enforced\n * - If a Bearer token is present, it will be forwarded in the Authorization header\n */\nexport function createRlsClientFromRequest(req: Request): SupabaseClient | null {\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const anonKey = process.env.SUPABASE_ANON_KEY;\n  if (!supabaseUrl || !anonKey) return null;\n\n  const auth = req.headers.get('authorization') || req.headers.get('Authorization') || '';\n  const [scheme, token] = auth.split(' ');\n  const bearer = scheme?.toLowerCase() === 'bearer' && token ? token : undefined;\n\n  const client = createClient(supabaseUrl, anonKey, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    },\n    global: bearer\n      ? { headers: { Authorization: `Bearer ${bearer}` } }\n      : undefined,\n  });\n  return client;\n}\n\nexport function getClientOrThrow(req: Request): SupabaseClient {\n  const client = createRlsClientFromRequest(req);\n  if (!client) throw new Error('Server is misconfigured: missing SUPABASE_URL or SUPABASE_ANON_KEY');\n  return client;\n}\n\n/**\n * Service-role client (bypasses RLS). Use only for admin/cron operations.\n */\nexport function getServiceClient(): SupabaseClient {\n  const supabaseUrl = process.env.SUPABASE_URL;\n  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;\n  if (!supabaseUrl || !serviceKey) {\n    throw new Error('Missing SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY');\n  }\n  return createClient(supabaseUrl, serviceKey, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    }\n  });\n}\n\n/**\n * Build-safe service client getter. Returns a lazy function that creates\n * the Supabase client only when actually invoked at runtime.\n * This prevents build-time errors during Next.js page collection.\n */\nexport function getSupabaseServiceClient() {\n  const url = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL;\n  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;\n\n  // During build time, env vars might not be available. Return a dummy client.\n  // This will fail if actually called, but won't crash the build.\n  if (!url || !key) {\n    // Create a minimal valid URL to satisfy Supabase's validation\n    // This won't work at runtime, but prevents build-time errors\n    return createClient('https://placeholder.supabase.co', 'placeholder-key', {\n      auth: { persistSession: false, detectSessionInUrl: false },\n    });\n  }\n\n  return createClient(url, key, {\n    auth: { persistSession: false, detectSessionInUrl: false },\n    db: {\n      schema: 'public'\n    }\n  });\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01RdQdkW78jP5Rnb5DpLetmW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GoBktd98u54fYJPzVDjhka","name":"Read","input":{"file_path":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/instagram-scheduler.ts"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":7169,"cache_read_input_tokens":32787,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7169},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"f9e8e692-4fa3-421e-b8fe-c43c22096dea"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GoBktd98u54fYJPzVDjhka","type":"tool_result","content":"     1→/**\n     2→ * Instagram Adaptive Scheduler\n     3→ *\n     4→ * Thompson Sampling engine that learns the best time and frequency\n     5→ * to post to Instagram based on historical engagement data.\n     6→ *\n     7→ * Algorithm:\n     8→ *   - Each (hour × day_of_week) slot has a Beta(alpha, beta) distribution.\n     9→ *   - alpha = weighted engagement successes, beta = posts - successes.\n    10→ *   - To pick next slot: sample from each slot's Beta, take argmax.\n    11→ *   - After posting, fetch metrics and update parameters.\n    12→ *   - Frequency (posts/day) adapts based on rolling 7-day engagement rate.\n    13→ */\n    14→\n    15→import { SupabaseClient } from '@supabase/supabase-js';\n    16→\n    17→// ─── Types ───────────────────────────────────────────────────────────────────\n    18→\n    19→export interface PostingConfig {\n    20→  user_id: string;\n    21→  min_posts_per_day: number;\n    22→  max_posts_per_day: number;\n    23→  current_target: number;\n    24→  quiet_start_hour: number;\n    25→  quiet_end_hour: number;\n    26→  learning_rate: number;\n    27→  engagement_threshold: number;\n    28→  last_posted_at: string | null;\n    29→  posts_last_7d: number;\n    30→  avg_engagement_7d: number;\n    31→  enabled: boolean;\n    32→}\n    33→\n    34→export interface SlotModel {\n    35→  hour_of_day: number;\n    36→  day_of_week: number;\n    37→  alpha: number;\n    38→  beta_param: number;\n    39→  posts_in_slot: number;\n    40→  avg_engagement: number;\n    41→}\n    42→\n    43→export interface ScheduledSlot {\n    44→  hour_of_day: number;\n    45→  day_of_week: number;\n    46→  scheduled_at: Date;\n    47→  expected_engagement: number;\n    48→}\n    49→\n    50→// ─── Beta distribution sampler (approximation using normal transform) ────────\n    51→\n    52→/** Sample from Beta(a, b) using Johnk's method approximation */\n    53→function sampleBeta(alpha: number, beta: number): number {\n    54→  // Use normal approximation for large params\n    55→  if (alpha > 1 && beta > 1) {\n    56→    const mu = alpha / (alpha + beta);\n    57→    const variance = (alpha * beta) / ((alpha + beta) ** 2 * (alpha + beta + 1));\n    58→    const sigma = Math.sqrt(variance);\n    59→    // Box-Muller transform\n    60→    const u1 = Math.random();\n    61→    const u2 = Math.random();\n    62→    const z = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);\n    63→    return Math.max(0.001, Math.min(0.999, mu + sigma * z));\n    64→  }\n    65→  // Exact sampling for small params via gamma ratio\n    66→  const x = sampleGamma(alpha);\n    67→  const y = sampleGamma(beta);\n    68→  return x / (x + y);\n    69→}\n    70→\n    71→function sampleGamma(k: number): number {\n    72→  // Marsaglia and Tsang's method\n    73→  if (k < 1) return sampleGamma(1 + k) * Math.pow(Math.random(), 1 / k);\n    74→  const d = k - 1 / 3;\n    75→  const c = 1 / Math.sqrt(9 * d);\n    76→  while (true) {\n    77→    let x: number, v: number;\n    78→    do {\n    79→      const u1 = Math.random(), u2 = Math.random();\n    80→      x = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);\n    81→      v = Math.pow(1 + c * x, 3);\n    82→    } while (v <= 0);\n    83→    const u = Math.random();\n    84→    if (u < 1 - 0.0331 * x ** 4) return d * v;\n    85→    if (Math.log(u) < 0.5 * x ** 2 + d * (1 - v + Math.log(v))) return d * v;\n    86→  }\n    87→}\n    88→\n    89→// ─── Core scheduler functions ─────────────────────────────────────────────────\n    90→\n    91→/**\n    92→ * Get or create publisher config for a user.\n    93→ * Seeds with evidence-based priors (IG best practice: Tue-Fri, 9am–3pm, 6pm–9pm).\n    94→ */\n    95→export async function getOrCreateConfig(\n    96→  supabase: SupabaseClient,\n    97→  userId: string\n    98→): Promise<PostingConfig> {\n    99→  const { data: existing } = await supabase\n   100→    .from('instagram_publisher_config')\n   101→    .select('*')\n   102→    .eq('user_id', userId)\n   103→    .single();\n   104→\n   105→  if (existing) return existing as PostingConfig;\n   106→\n   107→  const { data: created } = await supabase\n   108→    .from('instagram_publisher_config')\n   109→    .insert({ user_id: userId })\n   110→    .select()\n   111→    .single();\n   112→\n   113→  // Seed the model with IG best-practice priors\n   114→  await seedPriors(supabase, userId);\n   115→\n   116→  return created as PostingConfig;\n   117→}\n   118→\n   119→/**\n   120→ * Seed the posting model with Instagram best-practice priors.\n   121→ * High-engagement slots get alpha=2.5 (optimistic), low-engagement get alpha=1.0.\n   122→ */\n   123→export async function seedPriors(supabase: SupabaseClient, userId: string) {\n   124→  // Evidence-based high-engagement windows (UTC adjusted for US audience):\n   125→  // Mon-Fri: 9am-11am, 1pm-3pm, 7pm-9pm (roughly UTC 14-16, 18-20, 00-02)\n   126→  const highEngagementSlots = new Set([\n   127→    // Weekdays 9-11am EST = 14-16 UTC\n   128→    '1:14', '1:15', '2:14', '2:15', '3:14', '3:15', '4:14', '4:15', '5:14', '5:15',\n   129→    // Weekdays 1-3pm EST = 18-20 UTC\n   130→    '1:18', '1:19', '2:18', '2:19', '3:18', '3:19', '4:18', '4:19', '5:18', '5:19',\n   131→    // Weekdays 7-9pm EST = 00-02 UTC next day\n   132→    '2:0', '2:1', '3:0', '3:1', '4:0', '4:1', '5:0', '5:1',\n   133→    // Weekend afternoons\n   134→    '0:16', '0:17', '6:16', '6:17',\n   135→  ]);\n   136→\n   137→  const rows = [];\n   138→  for (let day = 0; day < 7; day++) {\n   139→    for (let hour = 0; hour < 24; hour++) {\n   140→      const isHigh = highEngagementSlots.has(`${day}:${hour}`);\n   141→      rows.push({\n   142→        user_id: userId,\n   143→        day_of_week: day,\n   144→        hour_of_day: hour,\n   145→        alpha: isHigh ? 2.5 : 1.0,\n   146→        beta_param: 1.0,\n   147→      });\n   148→    }\n   149→  }\n   150→\n   151→  // Upsert only if not already exists\n   152→  await supabase\n   153→    .from('instagram_posting_model')\n   154→    .upsert(rows, { onConflict: 'user_id,hour_of_day,day_of_week', ignoreDuplicates: true });\n   155→}\n   156→\n   157→/**\n   158→ * Use Thompson Sampling to pick the best next posting slot.\n   159→ * Respects quiet hours and minimum gap between posts.\n   160→ */\n   161→export async function pickNextSlot(\n   162→  supabase: SupabaseClient,\n   163→  userId: string,\n   164→  config: PostingConfig,\n   165→  fromTime: Date = new Date()\n   166→): Promise<ScheduledSlot | null> {\n   167→  const { data: modelRows } = await supabase\n   168→    .from('instagram_posting_model')\n   169→    .select('*')\n   170→    .eq('user_id', userId);\n   171→\n   172→  if (!modelRows || modelRows.length === 0) {\n   173→    await seedPriors(supabase, userId);\n   174→    return pickNextSlot(supabase, userId, config, fromTime);\n   175→  }\n   176→\n   177→  const slots = modelRows as SlotModel[];\n   178→\n   179→  // Sample from each slot's Beta distribution\n   180→  const candidates: Array<{ slot: SlotModel; sample: number; nextOccurrence: Date }> = [];\n   181→\n   182→  for (const slot of slots) {\n   183→    const sample = sampleBeta(slot.alpha, slot.beta_param);\n   184→    const nextOccurrence = nextSlotOccurrence(slot.hour_of_day, slot.day_of_week, fromTime, config);\n   185→    if (nextOccurrence) {\n   186→      candidates.push({ slot, sample, nextOccurrence });\n   187→    }\n   188→  }\n   189→\n   190→  if (candidates.length === 0) return null;\n   191→\n   192→  // Sort by Thompson sample (highest = most likely to be good)\n   193→  // Among slots within the next 48h, pick the best\n   194→  const within48h = candidates.filter(\n   195→    c => c.nextOccurrence.getTime() - fromTime.getTime() < 48 * 3600 * 1000\n   196→  );\n   197→\n   198→  const pool = within48h.length > 0 ? within48h : candidates;\n   199→  pool.sort((a, b) => b.sample - a.sample);\n   200→\n   201→  const best = pool[0];\n   202→  return {\n   203→    hour_of_day: best.slot.hour_of_day,\n   204→    day_of_week: best.slot.day_of_week,\n   205→    scheduled_at: best.nextOccurrence,\n   206→    expected_engagement: best.slot.avg_engagement,\n   207→  };\n   208→}\n   209→\n   210→/**\n   211→ * Find the next calendar occurrence of a given (hour, day_of_week) slot.\n   212→ * Skips quiet hours.\n   213→ */\n   214→function nextSlotOccurrence(\n   215→  hour: number,\n   216→  targetDay: number,\n   217→  from: Date,\n   218→  config: PostingConfig\n   219→): Date | null {\n   220→  // Is this hour in quiet hours?\n   221→  const { quiet_start_hour: qs, quiet_end_hour: qe } = config;\n   222→  const isQuiet = qs > qe\n   223→    ? (hour >= qs || hour < qe)   // overnight quiet window (e.g. 23→6)\n   224→    : (hour >= qs && hour < qe);  // same-day window\n   225→  if (isQuiet) return null;\n   226→\n   227→  // Find the next occurrence of targetDay at `hour` UTC\n   228→  const candidate = new Date(from);\n   229→  candidate.setUTCMinutes(0, 0, 0);\n   230→  candidate.setUTCHours(hour);\n   231→\n   232→  // Advance to the right day of week\n   233→  const currentDay = candidate.getUTCDay();\n   234→  let daysAhead = (targetDay - currentDay + 7) % 7;\n   235→  // If it's today but in the past (or < 15 min ahead), move to next week\n   236→  if (daysAhead === 0 && candidate.getTime() <= from.getTime() + 15 * 60 * 1000) {\n   237→    daysAhead = 7;\n   238→  }\n   239→  candidate.setUTCDate(candidate.getUTCDate() + daysAhead);\n   240→\n   241→  return candidate;\n   242→}\n   243→\n   244→/**\n   245→ * Determine if we should post now based on the current target frequency.\n   246→ * Returns true if the gap since last post meets the target cadence.\n   247→ */\n   248→export function shouldPostNow(config: PostingConfig): boolean {\n   249→  if (!config.enabled) return false;\n   250→  if (!config.last_posted_at) return true;\n   251→\n   252→  const hoursSinceLast =\n   253→    (Date.now() - new Date(config.last_posted_at).getTime()) / 3600000;\n   254→  const targetGapHours = 24 / config.current_target;\n   255→\n   256→  // Allow posting if we're within ±20% of the target gap\n   257→  return hoursSinceLast >= targetGapHours * 0.8;\n   258→}\n   259→\n   260→/**\n   261→ * Update the Beta distribution for a slot after a post is made and metrics are in.\n   262→ * Also updates the frequency target based on rolling engagement.\n   263→ */\n   264→export async function updateModel(\n   265→  supabase: SupabaseClient,\n   266→  userId: string,\n   267→  hour: number,\n   268→  day: number,\n   269→  engagementScore: number,\n   270→  config: PostingConfig\n   271→): Promise<void> {\n   272→  const isSuccess = engagementScore >= config.engagement_threshold;\n   273→\n   274→  // Update Beta parameters\n   275→  const { data: existing } = await supabase\n   276→    .from('instagram_posting_model')\n   277→    .select('alpha, beta_param, posts_in_slot, avg_engagement')\n   278→    .eq('user_id', userId)\n   279→    .eq('hour_of_day', hour)\n   280→    .eq('day_of_week', day)\n   281→    .single();\n   282→\n   283→  if (existing) {\n   284→    const newAlpha = existing.alpha + (isSuccess ? 1 : 0);\n   285→    const newBeta = existing.beta_param + (isSuccess ? 0 : 1);\n   286→    const n = existing.posts_in_slot + 1;\n   287→    // EWMA for average engagement\n   288→    const newAvg = existing.avg_engagement * (n - 1) / n + engagementScore / n;\n   289→\n   290→    await supabase\n   291→      .from('instagram_posting_model')\n   292→      .update({\n   293→        alpha: newAlpha,\n   294→        beta_param: newBeta,\n   295→        posts_in_slot: n,\n   296→        avg_engagement: newAvg,\n   297→        last_posted_at: new Date().toISOString(),\n   298→        updated_at: new Date().toISOString(),\n   299→      })\n   300→      .eq('user_id', userId)\n   301→      .eq('hour_of_day', hour)\n   302→      .eq('day_of_week', day);\n   303→  }\n   304→\n   305→  // Update frequency target via EWMA\n   306→  const lr = config.learning_rate;\n   307→  const targetEngagement = config.engagement_threshold * 1.5; // stretch goal\n   308→  const performanceRatio = engagementScore / targetEngagement;\n   309→  // If engagement is high → increase frequency; if low → reduce\n   310→  const newTarget = Math.max(\n   311→    config.min_posts_per_day,\n   312→    Math.min(\n   313→      config.max_posts_per_day,\n   314→      config.current_target * (1 - lr) + config.current_target * performanceRatio * lr\n   315→    )\n   316→  );\n   317→\n   318→  await supabase\n   319→    .from('instagram_publisher_config')\n   320→    .update({\n   321→      current_target: newTarget,\n   322→      avg_engagement_7d:\n   323→        config.avg_engagement_7d * 0.9 + engagementScore * 0.1,\n   324→      updated_at: new Date().toISOString(),\n   325→    })\n   326→    .eq('user_id', userId);\n   327→}\n   328→\n   329→/**\n   330→ * Return a summary of the model for a user — best slots, current target, etc.\n   331→ */\n   332→export async function getModelSummary(supabase: SupabaseClient, userId: string) {\n   333→  const [{ data: config }, { data: topSlots }] = await Promise.all([\n   334→    supabase\n   335→      .from('instagram_publisher_config')\n   336→      .select('*')\n   337→      .eq('user_id', userId)\n   338→      .single(),\n   339→    supabase\n   340→      .from('instagram_posting_model')\n   341→      .select('hour_of_day, day_of_week, alpha, beta_param, posts_in_slot, avg_engagement')\n   342→      .eq('user_id', userId)\n   343→      .order('avg_engagement', { ascending: false })\n   344→      .limit(10),\n   345→  ]);\n   346→\n   347→  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n   348→\n   349→  return {\n   350→    config,\n   351→    top_slots: (topSlots ?? []).map((s: SlotModel) => ({\n   352→      label: `${days[s.day_of_week]} ${s.hour_of_day}:00 UTC`,\n   353→      expected_engagement: s.avg_engagement,\n   354→      posts_sampled: s.posts_in_slot,\n   355→      confidence: s.alpha / (s.alpha + s.beta_param),\n   356→    })),\n   357→  };\n   358→}\n   359→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"c1f02133-0bbc-4520-be7a-6b9e27cc96e8","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/instagram-scheduler.ts","content":"/**\n * Instagram Adaptive Scheduler\n *\n * Thompson Sampling engine that learns the best time and frequency\n * to post to Instagram based on historical engagement data.\n *\n * Algorithm:\n *   - Each (hour × day_of_week) slot has a Beta(alpha, beta) distribution.\n *   - alpha = weighted engagement successes, beta = posts - successes.\n *   - To pick next slot: sample from each slot's Beta, take argmax.\n *   - After posting, fetch metrics and update parameters.\n *   - Frequency (posts/day) adapts based on rolling 7-day engagement rate.\n */\n\nimport { SupabaseClient } from '@supabase/supabase-js';\n\n// ─── Types ───────────────────────────────────────────────────────────────────\n\nexport interface PostingConfig {\n  user_id: string;\n  min_posts_per_day: number;\n  max_posts_per_day: number;\n  current_target: number;\n  quiet_start_hour: number;\n  quiet_end_hour: number;\n  learning_rate: number;\n  engagement_threshold: number;\n  last_posted_at: string | null;\n  posts_last_7d: number;\n  avg_engagement_7d: number;\n  enabled: boolean;\n}\n\nexport interface SlotModel {\n  hour_of_day: number;\n  day_of_week: number;\n  alpha: number;\n  beta_param: number;\n  posts_in_slot: number;\n  avg_engagement: number;\n}\n\nexport interface ScheduledSlot {\n  hour_of_day: number;\n  day_of_week: number;\n  scheduled_at: Date;\n  expected_engagement: number;\n}\n\n// ─── Beta distribution sampler (approximation using normal transform) ────────\n\n/** Sample from Beta(a, b) using Johnk's method approximation */\nfunction sampleBeta(alpha: number, beta: number): number {\n  // Use normal approximation for large params\n  if (alpha > 1 && beta > 1) {\n    const mu = alpha / (alpha + beta);\n    const variance = (alpha * beta) / ((alpha + beta) ** 2 * (alpha + beta + 1));\n    const sigma = Math.sqrt(variance);\n    // Box-Muller transform\n    const u1 = Math.random();\n    const u2 = Math.random();\n    const z = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);\n    return Math.max(0.001, Math.min(0.999, mu + sigma * z));\n  }\n  // Exact sampling for small params via gamma ratio\n  const x = sampleGamma(alpha);\n  const y = sampleGamma(beta);\n  return x / (x + y);\n}\n\nfunction sampleGamma(k: number): number {\n  // Marsaglia and Tsang's method\n  if (k < 1) return sampleGamma(1 + k) * Math.pow(Math.random(), 1 / k);\n  const d = k - 1 / 3;\n  const c = 1 / Math.sqrt(9 * d);\n  while (true) {\n    let x: number, v: number;\n    do {\n      const u1 = Math.random(), u2 = Math.random();\n      x = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);\n      v = Math.pow(1 + c * x, 3);\n    } while (v <= 0);\n    const u = Math.random();\n    if (u < 1 - 0.0331 * x ** 4) return d * v;\n    if (Math.log(u) < 0.5 * x ** 2 + d * (1 - v + Math.log(v))) return d * v;\n  }\n}\n\n// ─── Core scheduler functions ─────────────────────────────────────────────────\n\n/**\n * Get or create publisher config for a user.\n * Seeds with evidence-based priors (IG best practice: Tue-Fri, 9am–3pm, 6pm–9pm).\n */\nexport async function getOrCreateConfig(\n  supabase: SupabaseClient,\n  userId: string\n): Promise<PostingConfig> {\n  const { data: existing } = await supabase\n    .from('instagram_publisher_config')\n    .select('*')\n    .eq('user_id', userId)\n    .single();\n\n  if (existing) return existing as PostingConfig;\n\n  const { data: created } = await supabase\n    .from('instagram_publisher_config')\n    .insert({ user_id: userId })\n    .select()\n    .single();\n\n  // Seed the model with IG best-practice priors\n  await seedPriors(supabase, userId);\n\n  return created as PostingConfig;\n}\n\n/**\n * Seed the posting model with Instagram best-practice priors.\n * High-engagement slots get alpha=2.5 (optimistic), low-engagement get alpha=1.0.\n */\nexport async function seedPriors(supabase: SupabaseClient, userId: string) {\n  // Evidence-based high-engagement windows (UTC adjusted for US audience):\n  // Mon-Fri: 9am-11am, 1pm-3pm, 7pm-9pm (roughly UTC 14-16, 18-20, 00-02)\n  const highEngagementSlots = new Set([\n    // Weekdays 9-11am EST = 14-16 UTC\n    '1:14', '1:15', '2:14', '2:15', '3:14', '3:15', '4:14', '4:15', '5:14', '5:15',\n    // Weekdays 1-3pm EST = 18-20 UTC\n    '1:18', '1:19', '2:18', '2:19', '3:18', '3:19', '4:18', '4:19', '5:18', '5:19',\n    // Weekdays 7-9pm EST = 00-02 UTC next day\n    '2:0', '2:1', '3:0', '3:1', '4:0', '4:1', '5:0', '5:1',\n    // Weekend afternoons\n    '0:16', '0:17', '6:16', '6:17',\n  ]);\n\n  const rows = [];\n  for (let day = 0; day < 7; day++) {\n    for (let hour = 0; hour < 24; hour++) {\n      const isHigh = highEngagementSlots.has(`${day}:${hour}`);\n      rows.push({\n        user_id: userId,\n        day_of_week: day,\n        hour_of_day: hour,\n        alpha: isHigh ? 2.5 : 1.0,\n        beta_param: 1.0,\n      });\n    }\n  }\n\n  // Upsert only if not already exists\n  await supabase\n    .from('instagram_posting_model')\n    .upsert(rows, { onConflict: 'user_id,hour_of_day,day_of_week', ignoreDuplicates: true });\n}\n\n/**\n * Use Thompson Sampling to pick the best next posting slot.\n * Respects quiet hours and minimum gap between posts.\n */\nexport async function pickNextSlot(\n  supabase: SupabaseClient,\n  userId: string,\n  config: PostingConfig,\n  fromTime: Date = new Date()\n): Promise<ScheduledSlot | null> {\n  const { data: modelRows } = await supabase\n    .from('instagram_posting_model')\n    .select('*')\n    .eq('user_id', userId);\n\n  if (!modelRows || modelRows.length === 0) {\n    await seedPriors(supabase, userId);\n    return pickNextSlot(supabase, userId, config, fromTime);\n  }\n\n  const slots = modelRows as SlotModel[];\n\n  // Sample from each slot's Beta distribution\n  const candidates: Array<{ slot: SlotModel; sample: number; nextOccurrence: Date }> = [];\n\n  for (const slot of slots) {\n    const sample = sampleBeta(slot.alpha, slot.beta_param);\n    const nextOccurrence = nextSlotOccurrence(slot.hour_of_day, slot.day_of_week, fromTime, config);\n    if (nextOccurrence) {\n      candidates.push({ slot, sample, nextOccurrence });\n    }\n  }\n\n  if (candidates.length === 0) return null;\n\n  // Sort by Thompson sample (highest = most likely to be good)\n  // Among slots within the next 48h, pick the best\n  const within48h = candidates.filter(\n    c => c.nextOccurrence.getTime() - fromTime.getTime() < 48 * 3600 * 1000\n  );\n\n  const pool = within48h.length > 0 ? within48h : candidates;\n  pool.sort((a, b) => b.sample - a.sample);\n\n  const best = pool[0];\n  return {\n    hour_of_day: best.slot.hour_of_day,\n    day_of_week: best.slot.day_of_week,\n    scheduled_at: best.nextOccurrence,\n    expected_engagement: best.slot.avg_engagement,\n  };\n}\n\n/**\n * Find the next calendar occurrence of a given (hour, day_of_week) slot.\n * Skips quiet hours.\n */\nfunction nextSlotOccurrence(\n  hour: number,\n  targetDay: number,\n  from: Date,\n  config: PostingConfig\n): Date | null {\n  // Is this hour in quiet hours?\n  const { quiet_start_hour: qs, quiet_end_hour: qe } = config;\n  const isQuiet = qs > qe\n    ? (hour >= qs || hour < qe)   // overnight quiet window (e.g. 23→6)\n    : (hour >= qs && hour < qe);  // same-day window\n  if (isQuiet) return null;\n\n  // Find the next occurrence of targetDay at `hour` UTC\n  const candidate = new Date(from);\n  candidate.setUTCMinutes(0, 0, 0);\n  candidate.setUTCHours(hour);\n\n  // Advance to the right day of week\n  const currentDay = candidate.getUTCDay();\n  let daysAhead = (targetDay - currentDay + 7) % 7;\n  // If it's today but in the past (or < 15 min ahead), move to next week\n  if (daysAhead === 0 && candidate.getTime() <= from.getTime() + 15 * 60 * 1000) {\n    daysAhead = 7;\n  }\n  candidate.setUTCDate(candidate.getUTCDate() + daysAhead);\n\n  return candidate;\n}\n\n/**\n * Determine if we should post now based on the current target frequency.\n * Returns true if the gap since last post meets the target cadence.\n */\nexport function shouldPostNow(config: PostingConfig): boolean {\n  if (!config.enabled) return false;\n  if (!config.last_posted_at) return true;\n\n  const hoursSinceLast =\n    (Date.now() - new Date(config.last_posted_at).getTime()) / 3600000;\n  const targetGapHours = 24 / config.current_target;\n\n  // Allow posting if we're within ±20% of the target gap\n  return hoursSinceLast >= targetGapHours * 0.8;\n}\n\n/**\n * Update the Beta distribution for a slot after a post is made and metrics are in.\n * Also updates the frequency target based on rolling engagement.\n */\nexport async function updateModel(\n  supabase: SupabaseClient,\n  userId: string,\n  hour: number,\n  day: number,\n  engagementScore: number,\n  config: PostingConfig\n): Promise<void> {\n  const isSuccess = engagementScore >= config.engagement_threshold;\n\n  // Update Beta parameters\n  const { data: existing } = await supabase\n    .from('instagram_posting_model')\n    .select('alpha, beta_param, posts_in_slot, avg_engagement')\n    .eq('user_id', userId)\n    .eq('hour_of_day', hour)\n    .eq('day_of_week', day)\n    .single();\n\n  if (existing) {\n    const newAlpha = existing.alpha + (isSuccess ? 1 : 0);\n    const newBeta = existing.beta_param + (isSuccess ? 0 : 1);\n    const n = existing.posts_in_slot + 1;\n    // EWMA for average engagement\n    const newAvg = existing.avg_engagement * (n - 1) / n + engagementScore / n;\n\n    await supabase\n      .from('instagram_posting_model')\n      .update({\n        alpha: newAlpha,\n        beta_param: newBeta,\n        posts_in_slot: n,\n        avg_engagement: newAvg,\n        last_posted_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      })\n      .eq('user_id', userId)\n      .eq('hour_of_day', hour)\n      .eq('day_of_week', day);\n  }\n\n  // Update frequency target via EWMA\n  const lr = config.learning_rate;\n  const targetEngagement = config.engagement_threshold * 1.5; // stretch goal\n  const performanceRatio = engagementScore / targetEngagement;\n  // If engagement is high → increase frequency; if low → reduce\n  const newTarget = Math.max(\n    config.min_posts_per_day,\n    Math.min(\n      config.max_posts_per_day,\n      config.current_target * (1 - lr) + config.current_target * performanceRatio * lr\n    )\n  );\n\n  await supabase\n    .from('instagram_publisher_config')\n    .update({\n      current_target: newTarget,\n      avg_engagement_7d:\n        config.avg_engagement_7d * 0.9 + engagementScore * 0.1,\n      updated_at: new Date().toISOString(),\n    })\n    .eq('user_id', userId);\n}\n\n/**\n * Return a summary of the model for a user — best slots, current target, etc.\n */\nexport async function getModelSummary(supabase: SupabaseClient, userId: string) {\n  const [{ data: config }, { data: topSlots }] = await Promise.all([\n    supabase\n      .from('instagram_publisher_config')\n      .select('*')\n      .eq('user_id', userId)\n      .single(),\n    supabase\n      .from('instagram_posting_model')\n      .select('hour_of_day, day_of_week, alpha, beta_param, posts_in_slot, avg_engagement')\n      .eq('user_id', userId)\n      .order('avg_engagement', { ascending: false })\n      .limit(10),\n  ]);\n\n  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\n\n  return {\n    config,\n    top_slots: (topSlots ?? []).map((s: SlotModel) => ({\n      label: `${days[s.day_of_week]} ${s.hour_of_day}:00 UTC`,\n      expected_engagement: s.avg_engagement,\n      posts_sampled: s.posts_in_slot,\n      confidence: s.alpha / (s.alpha + s.beta_param),\n    })),\n  };\n}\n","numLines":359,"startLine":1,"totalLines":359}}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01RdQdkW78jP5Rnb5DpLetmW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QXNe8vrPcqiqp6oQxuDG8N","name":"Read","input":{"file_path":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/openai.ts"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":7169,"cache_read_input_tokens":32787,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7169},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"ca1e3cab-ba4b-4a4d-8d64-fb101d2f94e1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QXNe8vrPcqiqp6oQxuDG8N","type":"tool_result","content":"     1→import OpenAI from 'openai';\n     2→\n     3→let client: OpenAI | null = null;\n     4→\n     5→export function getOpenAIClient(): OpenAI {\n     6→  if (!process.env.OPENAI_API_KEY) {\n     7→    throw new Error('OPENAI_API_KEY not configured');\n     8→  }\n     9→  if (!client) {\n    10→    client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });\n    11→  }\n    12→  return client;\n    13→}\n    14→\n    15→export const DEFAULT_MODEL = 'gpt-4o-mini';\n    16→export const ADVANCED_MODEL = 'gpt-4o';\n    17→export const TRANSCRIPTION_MODEL = 'whisper-1';\n    18→\n    19→// System prompts for different agent personalities\n    20→export const SYSTEM_PROMPTS = {\n    21→  assistant: `You are an intelligent personal CRM assistant. You help users manage their contacts, relationships, and communications effectively. \n    22→You have access to their contacts, interaction history, voice notes, and personal context. \n    23→Be concise, helpful, and proactive in suggesting actions.`,\n    24→\n    25→  composer: `You are a message composition expert. You craft personalized, context-aware messages for different purposes (personal, networking, business).\n    26→You analyze the relationship history, user's voice notes about the contact, and tailor the tone and content appropriately.\n    27→Always consider the user's goals and the contact's context when composing messages.`,\n    28→\n    29→  analyzer: `You are a relationship intelligence analyst. You analyze contacts, interactions, and voice notes to provide insights.\n    30→You identify patterns, suggest engagement strategies, and help users strengthen their relationships.\n    31→Be specific, data-driven, and actionable in your recommendations.`,\n    32→\n    33→  transcriber: `You are a voice note processor. You transcribe audio accurately and extract key information:\n    34→- Main points and action items\n    35→- Contact references\n    36→- Sentiment and context\n    37→- Categories (personal/networking/business)\n    38→Format the output as structured JSON with extracted metadata.`,\n    39→\n    40→  contextBuilder: `You are a context aggregator. You synthesize information from multiple sources:\n    41→- Voice notes and persona notes\n    42→- Interaction history\n    43→- Contact details and tags\n    44→- User's stated goals\n    45→Create a comprehensive, relevant context summary for message composition or relationship insights.`\n    46→};\n    47→\n    48→// Agent function/tool definitions\n    49→export const AGENT_TOOLS: OpenAI.Chat.ChatCompletionTool[] = [\n    50→  {\n    51→    type: 'function',\n    52→    function: {\n    53→      name: 'get_contact',\n    54→      description: 'Retrieve detailed information about a specific contact by ID or search criteria',\n    55→      parameters: {\n    56→        type: 'object',\n    57→        properties: {\n    58→          contact_id: { type: 'string', description: 'UUID of the contact' },\n    59→          query: { type: 'string', description: 'Search query (name, email, tag)' }\n    60→        }\n    61→      }\n    62→    }\n    63→  },\n    64→  {\n    65→    type: 'function',\n    66→    function: {\n    67→      name: 'search_contacts',\n    68→      description: 'Search contacts by name, email, tags, or other criteria',\n    69→      parameters: {\n    70→        type: 'object',\n    71→        properties: {\n    72→          query: { type: 'string', description: 'Search query' },\n    73→          filters: {\n    74→            type: 'object',\n    75→            properties: {\n    76→              tag: { type: 'string' },\n    77→              warmth_band: { type: 'string', enum: ['hot', 'warm', 'neutral', 'cool', 'cold'] },\n    78→              pipeline: { type: 'string', enum: ['personal', 'networking', 'business'] }\n    79→            }\n    80→          },\n    81→          limit: { type: 'number', default: 10 }\n    82→        },\n    83→        required: ['query']\n    84→      }\n    85→    }\n    86→  },\n    87→  {\n    88→    type: 'function',\n    89→    function: {\n    90→      name: 'get_contact_interactions',\n    91→      description: 'Get recent interactions/messages with a contact',\n    92→      parameters: {\n    93→        type: 'object',\n    94→        properties: {\n    95→          contact_id: { type: 'string', description: 'Contact UUID' },\n    96→          limit: { type: 'number', default: 10 }\n    97→        },\n    98→        required: ['contact_id']\n    99→      }\n   100→    }\n   101→  },\n   102→  {\n   103→    type: 'function',\n   104→    function: {\n   105→      name: 'get_persona_notes',\n   106→      description: 'Get user\\'s voice notes and personal context about contacts or topics',\n   107→      parameters: {\n   108→        type: 'object',\n   109→        properties: {\n   110→          contact_id: { type: 'string', description: 'Filter by contact' },\n   111→          tags: { type: 'array', items: { type: 'string' }, description: 'Filter by tags' },\n   112→          type: { type: 'string', enum: ['text', 'voice'], description: 'Note type' },\n   113→          limit: { type: 'number', default: 5 }\n   114→        }\n   115→      }\n   116→    }\n   117→  },\n   118→  {\n   119→    type: 'function',\n   120→    function: {\n   121→      name: 'compose_message',\n   122→      description: 'Generate a context-aware message for a contact based on goal and relationship context',\n   123→      parameters: {\n   124→        type: 'object',\n   125→        properties: {\n   126→          contact_id: { type: 'string', description: 'Contact UUID' },\n   127→          goal_type: { type: 'string', enum: ['personal', 'networking', 'business'], description: 'Message goal' },\n   128→          goal_description: { type: 'string', description: 'Specific goal or purpose' },\n   129→          channel: { type: 'string', enum: ['email', 'sms', 'dm'], default: 'email' },\n   130→          tone: { type: 'string', enum: ['concise', 'warm', 'professional', 'playful'], default: 'warm' }\n   131→        },\n   132→        required: ['contact_id', 'goal_type']\n   133→      }\n   134→    }\n   135→  },\n   136→  {\n   137→    type: 'function',\n   138→    function: {\n   139→      name: 'analyze_contact',\n   140→      description: 'Analyze a contact\\'s profile and relationship to provide insights and suggestions',\n   141→      parameters: {\n   142→        type: 'object',\n   143→        properties: {\n   144→          contact_id: { type: 'string', description: 'Contact UUID' },\n   145→          analysis_type: {\n   146→            type: 'string',\n   147→            enum: ['relationship_health', 'engagement_suggestions', 'context_summary'],\n   148→            default: 'context_summary'\n   149→          }\n   150→        },\n   151→        required: ['contact_id']\n   152→      }\n   153→    }\n   154→  },\n   155→  {\n   156→    type: 'function',\n   157→    function: {\n   158→      name: 'update_contact',\n   159→      description: 'Update contact information (tags, notes, warmth, etc)',\n   160→      parameters: {\n   161→        type: 'object',\n   162→        properties: {\n   163→          contact_id: { type: 'string', description: 'Contact UUID' },\n   164→          updates: {\n   165→            type: 'object',\n   166→            properties: {\n   167→              tags: { type: 'array', items: { type: 'string' } },\n   168→              notes: { type: 'string' },\n   169→              warmth: { type: 'number', minimum: 0, maximum: 100 }\n   170→            }\n   171→          }\n   172→        },\n   173→        required: ['contact_id', 'updates']\n   174→      }\n   175→    }\n   176→  },\n   177→  {\n   178→    type: 'function',\n   179→    function: {\n   180→      name: 'get_message_goals',\n   181→      description: 'Get suggested message goals based on contact and user context',\n   182→      parameters: {\n   183→        type: 'object',\n   184→        properties: {\n   185→          contact_id: { type: 'string', description: 'Contact UUID' },\n   186→          category: { type: 'string', enum: ['personal', 'networking', 'business'] }\n   187→        },\n   188→        required: ['contact_id']\n   189→      }\n   190→    }\n   191→  },\n   192→  {\n   193→    type: 'function',\n   194→    function: {\n   195→      name: 'process_voice_note',\n   196→      description: 'Process a voice note: extract entities, sentiment, action items, and associate with contacts',\n   197→      parameters: {\n   198→        type: 'object',\n   199→        properties: {\n   200→          note_id: { type: 'string', description: 'Voice note UUID' },\n   201→          extract_contacts: { type: 'boolean', default: true, description: 'Extract contact references' },\n   202→          extract_actions: { type: 'boolean', default: true, description: 'Extract action items' }\n   203→        },\n   204→        required: ['note_id']\n   205→      }\n   206→    }\n   207→  }\n   208→];\n   209→\n   210→// Helper to build context from multiple sources\n   211→export async function buildAgentContext(userId: string, contactId?: string, includePersonaNotes: boolean = true) {\n   212→  // This will be called by routes to aggregate context\n   213→  return {\n   214→    user_id: userId,\n   215→    contact_id: contactId,\n   216→    timestamp: new Date().toISOString(),\n   217→    context_sources: {\n   218→      persona_notes: includePersonaNotes,\n   219→      interactions: true,\n   220→      contact_details: !!contactId\n   221→    }\n   222→  };\n   223→}\n   224→\n   225→// Token counting utility\n   226→export function estimateTokens(text: string): number {\n   227→  // Rough estimate: ~4 characters per token\n   228→  return Math.ceil(text.length / 4);\n   229→}\n   230→\n   231→// Stream handler helper\n   232→export function createStreamHandler(onChunk: (chunk: string) => void) {\n   233→  return async (stream: AsyncIterable<OpenAI.Chat.Completions.ChatCompletionChunk>) => {\n   234→    for await (const chunk of stream) {\n   235→      const content = chunk.choices[0]?.delta?.content || '';\n   236→      if (content) onChunk(content);\n   237→    }\n   238→  };\n   239→}\n   240→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"67365dda-5c60-4586-af0b-adba47a6c3ca","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/lib/openai.ts","content":"import OpenAI from 'openai';\n\nlet client: OpenAI | null = null;\n\nexport function getOpenAIClient(): OpenAI {\n  if (!process.env.OPENAI_API_KEY) {\n    throw new Error('OPENAI_API_KEY not configured');\n  }\n  if (!client) {\n    client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });\n  }\n  return client;\n}\n\nexport const DEFAULT_MODEL = 'gpt-4o-mini';\nexport const ADVANCED_MODEL = 'gpt-4o';\nexport const TRANSCRIPTION_MODEL = 'whisper-1';\n\n// System prompts for different agent personalities\nexport const SYSTEM_PROMPTS = {\n  assistant: `You are an intelligent personal CRM assistant. You help users manage their contacts, relationships, and communications effectively. \nYou have access to their contacts, interaction history, voice notes, and personal context. \nBe concise, helpful, and proactive in suggesting actions.`,\n\n  composer: `You are a message composition expert. You craft personalized, context-aware messages for different purposes (personal, networking, business).\nYou analyze the relationship history, user's voice notes about the contact, and tailor the tone and content appropriately.\nAlways consider the user's goals and the contact's context when composing messages.`,\n\n  analyzer: `You are a relationship intelligence analyst. You analyze contacts, interactions, and voice notes to provide insights.\nYou identify patterns, suggest engagement strategies, and help users strengthen their relationships.\nBe specific, data-driven, and actionable in your recommendations.`,\n\n  transcriber: `You are a voice note processor. You transcribe audio accurately and extract key information:\n- Main points and action items\n- Contact references\n- Sentiment and context\n- Categories (personal/networking/business)\nFormat the output as structured JSON with extracted metadata.`,\n\n  contextBuilder: `You are a context aggregator. You synthesize information from multiple sources:\n- Voice notes and persona notes\n- Interaction history\n- Contact details and tags\n- User's stated goals\nCreate a comprehensive, relevant context summary for message composition or relationship insights.`\n};\n\n// Agent function/tool definitions\nexport const AGENT_TOOLS: OpenAI.Chat.ChatCompletionTool[] = [\n  {\n    type: 'function',\n    function: {\n      name: 'get_contact',\n      description: 'Retrieve detailed information about a specific contact by ID or search criteria',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'UUID of the contact' },\n          query: { type: 'string', description: 'Search query (name, email, tag)' }\n        }\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'search_contacts',\n      description: 'Search contacts by name, email, tags, or other criteria',\n      parameters: {\n        type: 'object',\n        properties: {\n          query: { type: 'string', description: 'Search query' },\n          filters: {\n            type: 'object',\n            properties: {\n              tag: { type: 'string' },\n              warmth_band: { type: 'string', enum: ['hot', 'warm', 'neutral', 'cool', 'cold'] },\n              pipeline: { type: 'string', enum: ['personal', 'networking', 'business'] }\n            }\n          },\n          limit: { type: 'number', default: 10 }\n        },\n        required: ['query']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'get_contact_interactions',\n      description: 'Get recent interactions/messages with a contact',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Contact UUID' },\n          limit: { type: 'number', default: 10 }\n        },\n        required: ['contact_id']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'get_persona_notes',\n      description: 'Get user\\'s voice notes and personal context about contacts or topics',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Filter by contact' },\n          tags: { type: 'array', items: { type: 'string' }, description: 'Filter by tags' },\n          type: { type: 'string', enum: ['text', 'voice'], description: 'Note type' },\n          limit: { type: 'number', default: 5 }\n        }\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'compose_message',\n      description: 'Generate a context-aware message for a contact based on goal and relationship context',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Contact UUID' },\n          goal_type: { type: 'string', enum: ['personal', 'networking', 'business'], description: 'Message goal' },\n          goal_description: { type: 'string', description: 'Specific goal or purpose' },\n          channel: { type: 'string', enum: ['email', 'sms', 'dm'], default: 'email' },\n          tone: { type: 'string', enum: ['concise', 'warm', 'professional', 'playful'], default: 'warm' }\n        },\n        required: ['contact_id', 'goal_type']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'analyze_contact',\n      description: 'Analyze a contact\\'s profile and relationship to provide insights and suggestions',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Contact UUID' },\n          analysis_type: {\n            type: 'string',\n            enum: ['relationship_health', 'engagement_suggestions', 'context_summary'],\n            default: 'context_summary'\n          }\n        },\n        required: ['contact_id']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'update_contact',\n      description: 'Update contact information (tags, notes, warmth, etc)',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Contact UUID' },\n          updates: {\n            type: 'object',\n            properties: {\n              tags: { type: 'array', items: { type: 'string' } },\n              notes: { type: 'string' },\n              warmth: { type: 'number', minimum: 0, maximum: 100 }\n            }\n          }\n        },\n        required: ['contact_id', 'updates']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'get_message_goals',\n      description: 'Get suggested message goals based on contact and user context',\n      parameters: {\n        type: 'object',\n        properties: {\n          contact_id: { type: 'string', description: 'Contact UUID' },\n          category: { type: 'string', enum: ['personal', 'networking', 'business'] }\n        },\n        required: ['contact_id']\n      }\n    }\n  },\n  {\n    type: 'function',\n    function: {\n      name: 'process_voice_note',\n      description: 'Process a voice note: extract entities, sentiment, action items, and associate with contacts',\n      parameters: {\n        type: 'object',\n        properties: {\n          note_id: { type: 'string', description: 'Voice note UUID' },\n          extract_contacts: { type: 'boolean', default: true, description: 'Extract contact references' },\n          extract_actions: { type: 'boolean', default: true, description: 'Extract action items' }\n        },\n        required: ['note_id']\n      }\n    }\n  }\n];\n\n// Helper to build context from multiple sources\nexport async function buildAgentContext(userId: string, contactId?: string, includePersonaNotes: boolean = true) {\n  // This will be called by routes to aggregate context\n  return {\n    user_id: userId,\n    contact_id: contactId,\n    timestamp: new Date().toISOString(),\n    context_sources: {\n      persona_notes: includePersonaNotes,\n      interactions: true,\n      contact_details: !!contactId\n    }\n  };\n}\n\n// Token counting utility\nexport function estimateTokens(text: string): number {\n  // Rough estimate: ~4 characters per token\n  return Math.ceil(text.length / 4);\n}\n\n// Stream handler helper\nexport function createStreamHandler(onChunk: (chunk: string) => void) {\n  return async (stream: AsyncIterable<OpenAI.Chat.Completions.ChatCompletionChunk>) => {\n    for await (const chunk of stream) {\n      const content = chunk.choices[0]?.delta?.content || '';\n      if (content) onChunk(content);\n    }\n  };\n}\n","numLines":240,"startLine":1,"totalLines":240}}}
