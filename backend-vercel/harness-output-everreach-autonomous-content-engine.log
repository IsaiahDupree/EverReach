{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MqR4EPRskP6fLZ5pURxGnj","type":"tool_result","content":"The file /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/v1/content/health/route.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"eb4472d8-2d98-4b2e-984c-a22e7f287505","uuid":"3a261ae2-8b5c-4382-8bde-d3943dcdafb1","tool_use_result":{"filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/v1/content/health/route.ts","oldString":"export async function GET() {\n  try {\n    const supabase = getServiceClient();\n    const issues = [];\n\n    // 1. Check Supabase connectivity and templates\n    const { count: templateCount, error: countErr } = await supabase\n      .from('content_templates')\n      .select('id', { count: 'exact', head: true });\n\n    if (countErr || !templateCount || templateCount === 0) {\n      issues.push('Supabase connectivity failed or no templates found');\n    }\n\n    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }\n\n    // 3. Check active model weights\n    const { data: activeWeights, error: weightsErr } = await supabase\n      .from('model_weights')\n      .select('id')\n      .eq('is_active', true)\n      .single();\n\n    if (weightsErr || !activeWeights) {\n      issues.push('No active model_weights found');\n    }\n\n    const isHealthy = issues.length === 0;\n\n    return NextResponse.json(\n      {\n        ok: isHealthy,\n        supabase: 'connected',\n        openai_key: apiKey ? 'present' : 'missing',\n        templates: templateCount || 0,\n        model_weights: activeWeights ? 'active' : 'missing',\n        issues: issues.length > 0 ? issues : undefined,\n      },\n      { status: isHealthy ? 200 : 503 }\n    );\n  } catch (error) {\n    console.error('Health check failed:', error);\n    return NextResponse.json(\n      { ok: false, error: String(error), issues: ['Unexpected error during health check'] },\n      { status: 503 }\n    );\n  }\n}","newString":"export async function GET() {\n  try {\n    const supabase = getServiceClient();\n    const issues = [];\n\n    // 1. Check Supabase connectivity and templates\n    const { data: templates, error: templatesErr } = await supabase\n      .from('content_templates')\n      .select('id')\n      .limit(1);\n\n    const templateCount = templates?.length || 0;\n    if (templatesErr || templateCount === 0) {\n      issues.push('Supabase connectivity failed or no templates found');\n    }\n\n    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }\n\n    // 3. Check active model weights\n    const { data: activeWeights, error: weightsErr } = await supabase\n      .from('model_weights')\n      .select('id')\n      .eq('is_active', true)\n      .limit(1);\n\n    const hasWeights = !weightsErr && activeWeights && activeWeights.length > 0;\n    if (!hasWeights) {\n      issues.push('No active model_weights found');\n    }\n\n    const isHealthy = issues.length === 0;\n\n    return NextResponse.json(\n      {\n        ok: isHealthy,\n        supabase: 'connected',\n        openai_key: apiKey ? 'present' : 'missing',\n        templates: templateCount,\n        model_weights: hasWeights ? 'active' : 'missing',\n        issues: issues.length > 0 ? issues : undefined,\n      },\n      { status: isHealthy ? 200 : 503 }\n    );\n  } catch (error) {\n    console.error('Health check failed:', error);\n    return NextResponse.json(\n      { ok: false, error: String(error), issues: ['Unexpected error during health check'] },\n      { status: 503 }\n    );\n  }\n}","originalFile":"/**\n * Content Engine Health Endpoint\n * GET /api/v1/content/health\n *\n * Checks: Supabase connectivity, OpenAI API key, content_templates count,\n * active model_weights exists\n */\n\nimport { NextResponse } from 'next/server';\nimport { getServiceClient } from '@/lib/supabase';\n\nexport const runtime = 'nodejs';\n\nexport async function GET() {\n  try {\n    const supabase = getServiceClient();\n    const issues = [];\n\n    // 1. Check Supabase connectivity and templates\n    const { count: templateCount, error: countErr } = await supabase\n      .from('content_templates')\n      .select('id', { count: 'exact', head: true });\n\n    if (countErr || !templateCount || templateCount === 0) {\n      issues.push('Supabase connectivity failed or no templates found');\n    }\n\n    // 2. Check OpenAI API key\n    const apiKey = process.env.OPENAI_API_KEY;\n    if (!apiKey) {\n      issues.push('OPENAI_API_KEY not configured');\n    }\n\n    // 3. Check active model weights\n    const { data: activeWeights, error: weightsErr } = await supabase\n      .from('model_weights')\n      .select('id')\n      .eq('is_active', true)\n      .single();\n\n    if (weightsErr || !activeWeights) {\n      issues.push('No active model_weights found');\n    }\n\n    const isHealthy = issues.length === 0;\n\n    return NextResponse.json(\n      {\n        ok: isHealthy,\n        supabase: 'connected',\n        openai_key: apiKey ? 'present' : 'missing',\n        templates: templateCount || 0,\n        model_weights: activeWeights ? 'active' : 'missing',\n        issues: issues.length > 0 ? issues : undefined,\n      },\n      { status: isHealthy ? 200 : 503 }\n    );\n  } catch (error) {\n    console.error('Health check failed:', error);\n    return NextResponse.json(\n      { ok: false, error: String(error), issues: ['Unexpected error during health check'] },\n      { status: 503 }\n    );\n  }\n}\n","structuredPatch":[{"oldStart":17,"oldLines":11,"newStart":17,"newLines":13,"lines":["     const issues = [];"," ","     // 1. Check Supabase connectivity and templates","-    const { count: templateCount, error: countErr } = await supabase","+    const { data: templates, error: templatesErr } = await supabase","       .from('content_templates')","-      .select('id', { count: 'exact', head: true });","+      .select('id')","+      .limit(1);"," ","-    if (countErr || !templateCount || templateCount === 0) {","+    const templateCount = templates?.length || 0;","+    if (templatesErr || templateCount === 0) {","       issues.push('Supabase connectivity failed or no templates found');","     }"," "]},{"oldStart":36,"oldLines":9,"newStart":38,"newLines":10,"lines":["       .from('model_weights')","       .select('id')","       .eq('is_active', true)","-      .single();","+      .limit(1);"," ","-    if (weightsErr || !activeWeights) {","+    const hasWeights = !weightsErr && activeWeights && activeWeights.length > 0;","+    if (!hasWeights) {","       issues.push('No active model_weights found');","     }"," "]},{"oldStart":49,"oldLines":8,"newStart":52,"newLines":8,"lines":["         ok: isHealthy,","         supabase: 'connected',","         openai_key: apiKey ? 'present' : 'missing',","-        templates: templateCount || 0,","-        model_weights: activeWeights ? 'active' : 'missing',","+        templates: templateCount,","+        model_weights: hasWeights ? 'active' : 'missing',","         issues: issues.length > 0 ? issues : undefined,","       },","       { status: isHealthy ? 200 : 503 }"]}],"userModified":false,"replaceAll":false}}
