{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_0112kQdN7Hi9Vq56ibztDtQe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XJxMefy9qgdGc47Uhw67kc","name":"mcp__supabase__apply_migration","input":{"name":"ace_post_queue","query":"-- Post Queue: unified queue for autonomous content engine\nCREATE TABLE IF NOT EXISTS post_queue (\n  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n  candidate_id UUID REFERENCES content_candidates(id) ON DELETE SET NULL,\n  copy_variant_id UUID REFERENCES content_copy_variants(id) ON DELETE SET NULL,\n  asset_id UUID REFERENCES content_assets(id) ON DELETE SET NULL,\n  queue_source TEXT NOT NULL DEFAULT 'autonomous' CHECK (queue_source IN ('autonomous', 'manual', 'evergreen_seed')),\n  queue_status TEXT NOT NULL DEFAULT 'queued' CHECK (queue_status IN ('queued', 'scheduled', 'publishing', 'published', 'failed', 'cancelled')),\n  platform TEXT NOT NULL DEFAULT 'instagram',\n  media_type TEXT NOT NULL DEFAULT 'IMAGE',\n  image_url TEXT,\n  video_url TEXT,\n  caption TEXT NOT NULL,\n  priority INTEGER DEFAULT 5,\n  auto_schedule BOOLEAN DEFAULT true,\n  scheduled_at TIMESTAMPTZ,\n  published_at TIMESTAMPTZ,\n  platform_post_id TEXT,\n  permalink TEXT,\n  dedupe_key TEXT UNIQUE,\n  error TEXT,\n  retry_count INTEGER DEFAULT 0,\n  metadata JSONB DEFAULT '{}',\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nCREATE INDEX idx_post_queue_status ON post_queue(queue_status);\nCREATE INDEX idx_post_queue_scheduled ON post_queue(scheduled_at) WHERE queue_status = 'queued';\nCREATE INDEX idx_post_queue_candidate ON post_queue(candidate_id);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":9,"cache_creation_input_tokens":4412,"cache_read_input_tokens":61515,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4412},"output_tokens":1,"service_tier":"standard","inferenc