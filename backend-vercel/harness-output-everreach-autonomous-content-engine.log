{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_018ehMd93HvegKD5wZYu4z9u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AJny1SQLxHMUGVohxiXYVC","name":"Write","input":{"file_path":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/cron/signals-sync/route.ts","content":"/**\n * Signals Sync — Cron Job\n *\n * Ingests content signals from:\n * 1. instagram_post_performance — tags top posts by pillar/format\n * 2. Static seed of 10 evergreen app-store review signals\n *\n * Uses job_runs for idempotency with run_key = date\n * Writes rows to content_signals table\n *\n * Trigger: daily at 00:30 UTC\n * GET /api/cron/signals-sync\n */\n\nimport { NextResponse } from 'next/server';\nimport { getServiceClient } from '@/lib/supabase';\n\nexport const runtime = 'nodejs';\n\nasync function syncSignals() {\n  const supabase = getServiceClient();\n\n  // 1. Check if already run today using job_runs\n  const now = new Date();\n  const dateKey = now.toISOString().split('T')[0]; // YYYY-MM-DD\n\n  const { data: existingRun } = await supabase\n    .from('job_runs')\n    .select('id')\n    .eq('job_name', 'signals-sync')\n    .eq('run_key', dateKey)\n    .single();\n\n  if (existingRun) {\n    return { ok: true, inserted: 0, note: 'Already ran today' };\n  }\n\n  const inserted: string[] = [];\n\n  try {\n    // 2. Ingest top posts from instagram_post_performance\n    const { data: topPosts } = await supabase\n      .from('instagram_post_performance')\n      .select('id, platform_post_id, caption, likes, comments, saves, shares, reach, pillar, format_type, created_at')\n      .order('created_at', { ascending: false })\n      .limit(20);\n\n    if (topPosts && topPosts.length > 0) {\n      const signals = topPosts.map((post: any) => ({\n        source_type: 'instagram_performance',\n        signal_category: post.pillar || 'general',\n        signal_text: `High-performing post (${post.likes} likes, ${post.reach} reach): \"${post.caption?.substring(0, 100)}\"`,\n        metadata: {\n          post_id: post.platform_post_id,\n          engagement: post.likes + post.comments * 3 + post.saves * 5 + post.shares * 7,\n          format: post.format_type,\n        },\n      }));\n\n      const { error: insertErr } = await supabase.from('content_signals').insert(signals);\n      if (insertErr) throw insertErr;\n      inserted.push(...signals.map((_, i) => `ig_perf_${i}`));\n    }\n\n    // 3. Seed evergreen app-store review signals\n    const seedSignals = [\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'friendship_fade',\n        signal_text: 'Users mention: losing touch with old friends, reconnecting after years',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'adult_friendship_psychology',\n        signal_text: 'Review highlights: how hard it is to make friends as an adult',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'relationship_systems',\n        signal_text: 'Common mention: structured approach to maintaining relationships',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'warmth_score',\n        signal_text: 'Users appreciate: quantified relationship health metrics',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'outreach_intelligence',\n        signal_text: 'Feature request: smarter timing for reaching out to contacts',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'product_education',\n        signal_text: 'Feedback: users need onboarding on relationship pillar framework',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'proof_and_trust',\n        signal_text: 'Users mention: trust in data accuracy and privacy',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'conversion',\n        signal_text: 'Review: users upgrade to Pro for advanced features',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'friendship_fade',\n        signal_text: 'Common pain point: maintaining childhood friendships over distance',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'adult_friendship_psychology',\n        signal_text: 'Users report: anxiety about initiating contact with long-lost friends',\n      },\n    ];\n\n    const { error: seedErr } = await supabase.from('content_signals').insert(seedSignals);\n    if (seedErr) throw seedErr;\n    inserted.push(...seedSignals.map((_, i) => `seed_${i}`));\n\n    // 4. Record in job_runs\n    const { error: jobRunErr } = await supabase.from('job_runs').insert({\n      job_name: 'signals-sync',\n      run_key: dateKey,\n      status: 'completed',\n      completed_at: new Date().toISOString(),\n    });\n    if (jobRunErr) throw jobRunErr;\n\n    return { ok: true, inserted: inserted.length };\n  } catch (error) {\n    console.error('Signals sync error:', error);\n    throw error;\n  }\n}\n\nexport async function GET() {\n  try {\n    const result = await syncSignals();\n    return NextResponse.json(result);\n  } catch (error) {\n    console.error('Signals sync cron failed:', error);\n    return NextResponse.json({ ok: false, error: String(error) }, { status: 500 });\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1091,"cache_read_input_tokens":102692,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1091},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"eb4472d8-2d98-4b2e-984c-a22e7f287505","uuid":"8545bffa-8dfd-49c5-9734-d9f110589ee5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJny1SQLxHMUGVohxiXYVC","type":"tool_result","content":"File created successfully at: /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/cron/signals-sync/route.ts"}]},"parent_tool_use_id":null,"session_id":"eb4472d8-2d98-4b2e-984c-a22e7f287505","uuid":"198fa517-0f60-4431-981a-ec31fc085280","tool_use_result":{"type":"create","filePath":"/Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/app/api/cron/signals-sync/route.ts","content":"/**\n * Signals Sync — Cron Job\n *\n * Ingests content signals from:\n * 1. instagram_post_performance — tags top posts by pillar/format\n * 2. Static seed of 10 evergreen app-store review signals\n *\n * Uses job_runs for idempotency with run_key = date\n * Writes rows to content_signals table\n *\n * Trigger: daily at 00:30 UTC\n * GET /api/cron/signals-sync\n */\n\nimport { NextResponse } from 'next/server';\nimport { getServiceClient } from '@/lib/supabase';\n\nexport const runtime = 'nodejs';\n\nasync function syncSignals() {\n  const supabase = getServiceClient();\n\n  // 1. Check if already run today using job_runs\n  const now = new Date();\n  const dateKey = now.toISOString().split('T')[0]; // YYYY-MM-DD\n\n  const { data: existingRun } = await supabase\n    .from('job_runs')\n    .select('id')\n    .eq('job_name', 'signals-sync')\n    .eq('run_key', dateKey)\n    .single();\n\n  if (existingRun) {\n    return { ok: true, inserted: 0, note: 'Already ran today' };\n  }\n\n  const inserted: string[] = [];\n\n  try {\n    // 2. Ingest top posts from instagram_post_performance\n    const { data: topPosts } = await supabase\n      .from('instagram_post_performance')\n      .select('id, platform_post_id, caption, likes, comments, saves, shares, reach, pillar, format_type, created_at')\n      .order('created_at', { ascending: false })\n      .limit(20);\n\n    if (topPosts && topPosts.length > 0) {\n      const signals = topPosts.map((post: any) => ({\n        source_type: 'instagram_performance',\n        signal_category: post.pillar || 'general',\n        signal_text: `High-performing post (${post.likes} likes, ${post.reach} reach): \"${post.caption?.substring(0, 100)}\"`,\n        metadata: {\n          post_id: post.platform_post_id,\n          engagement: post.likes + post.comments * 3 + post.saves * 5 + post.shares * 7,\n          format: post.format_type,\n        },\n      }));\n\n      const { error: insertErr } = await supabase.from('content_signals').insert(signals);\n      if (insertErr) throw insertErr;\n      inserted.push(...signals.map((_, i) => `ig_perf_${i}`));\n    }\n\n    // 3. Seed evergreen app-store review signals\n    const seedSignals = [\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'friendship_fade',\n        signal_text: 'Users mention: losing touch with old friends, reconnecting after years',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'adult_friendship_psychology',\n        signal_text: 'Review highlights: how hard it is to make friends as an adult',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'relationship_systems',\n        signal_text: 'Common mention: structured approach to maintaining relationships',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'warmth_score',\n        signal_text: 'Users appreciate: quantified relationship health metrics',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'outreach_intelligence',\n        signal_text: 'Feature request: smarter timing for reaching out to contacts',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'product_education',\n        signal_text: 'Feedback: users need onboarding on relationship pillar framework',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'proof_and_trust',\n        signal_text: 'Users mention: trust in data accuracy and privacy',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'conversion',\n        signal_text: 'Review: users upgrade to Pro for advanced features',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'friendship_fade',\n        signal_text: 'Common pain point: maintaining childhood friendships over distance',\n      },\n      {\n        source_type: 'app_store_reviews',\n        signal_category: 'adult_friendship_psychology',\n        signal_text: 'Users report: anxiety about initiating contact with long-lost friends',\n      },\n    ];\n\n    const { error: seedErr } = await supabase.from('content_signals').insert(seedSignals);\n    if (seedErr) throw seedErr;\n    inserted.push(...seedSignals.map((_, i) => `seed_${i}`));\n\n    // 4. Record in job_runs\n    const { error: jobRunErr } = await supabase.from('job_runs').insert({\n      job_name: 'signals-sync',\n      run_key: dateKey,\n      status: 'completed',\n      completed_at: new Date().toISOString(),\n    });\n    if (jobRunErr) throw jobRunErr;\n\n    return { ok: true, inserted: inserted.length };\n  } catch (error) {\n    console.error('Signals sync error:', error);\n    throw error;\n  }\n}\n\nexport async function GET() {\n  try {\n    const result = await syncSignals();\n    return NextResponse.json(result);\n  } catch (error) {\n    console.error('Signals sync cron failed:', error);\n    return NextResponse.json({ ok: false, error: String(error) }, { status: 500 });\n  }\n}\n","structuredPatch":[],"originalFile":null}}
