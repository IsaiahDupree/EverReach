{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011W8s3pDWpJAtHT8fSkUz6v","type":"tool_result","content":"     1→{\n     2→  \"project\": \"everreach-autonomous-content-engine\",\n     3→  \"version\": \"1.0.0\",\n     4→  \"description\": \"20 features: Supabase schema, 7 cron routes, copy/asset/QA pipeline, learning loop, dashboard, evergreen seed posts, E2E test, Vercel deploy\",\n     5→  \"features\": [\n     6→  {\n     7→    \"id\": \"ACE-001\",\n     8→    \"title\": \"Database Schema Migration\",\n     9→    \"description\": \"Apply all 11 Supabase table migrations via mcp__supabase__apply_migration: content_signals, content_strategy_briefs, content_candidates, content_copy_variants, content_templates, content_assets, post_queue, published_posts, post_performance, model_weights, job_runs. Seed model_weights with default scoring weights and content_templates with 5 initial template records.\",\n    10→    \"category\": \"infrastructure\",\n    11→    \"priority\": 1,\n    12→    \"passes\": false,\n    13→    \"status\": \"pending\",\n    14→    \"acceptance_criteria\": [\n    15→      \"All 11 tables exist in Supabase\",\n    16→      \"model_weights has 1 active row with correct 7 weight fields\",\n    17→      \"content_templates has 5 seed rows (static_truth_v1, carousel_psychology_v1, carousel_framework_v1, product_screenshot_v1, founder_note_v1)\",\n    18→      \"job_runs has UNIQUE constraint on (job_name, run_key)\"\n    19→    ]\n    20→  },\n    21→  {\n    22→    \"id\": \"ACE-002\",\n    23→    \"title\": \"vercel.json Cron Additions\",\n    24→    \"description\": \"Add 7 new cron entries to /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/vercel.json for the content engine pipeline. Preserve all existing cron entries.\",\n    25→    \"category\": \"infrastructure\",\n    26→    \"priority\": 1,\n    27→    \"passes\": false,\n    28→    \"status\": \"pending\",\n    29→    \"acceptance_criteria\": [\n    30→      \"vercel.json has 7 new cron paths: /api/cron/signals-sync, strategy-generate, candidates-generate, candidates-score, copy-and-assets, qa-and-queue-fill, content-model-update\",\n    31→      \"All existing crons (instagram-publisher, instagram-engagement-sync, etc.) are preserved\",\n    32→      \"File is valid JSON\"\n    33→    ]\n    34→  },\n    35→  {\n    36→    \"id\": \"ACE-003\",\n    37→    \"title\": \"Signals Sync Cron + API Route\",\n    38→    \"description\": \"Create /api/cron/signals-sync and /api/v1/content/signals/sync. The job ingests signals from: (1) instagram_post_performance — tag top posts by pillar/format, (2) a static seed of 10 evergreen app-store review signals. Uses job_runs for idempotency with run_key = date. Writes rows to content_signals table.\",\n    39→    \"category\": \"cron\",\n    40→    \"priority\": 1,\n    41→    \"passes\": false,\n    42→    \"status\": \"pending\",\n    43→    \"acceptance_criteria\": [\n    44→      \"GET /api/cron/signals-sync returns {ok: true, inserted: N}\",\n    45→      \"POST /api/v1/content/signals/sync works with same logic\",\n    46→      \"job_runs deduplication prevents re-running same day\",\n    47→      \"content_signals rows have source_type, signal_category, signal_text populated\",\n    48→      \"Returns 200 with metadata, not 500\"\n    49→    ]\n    50→  },\n    51→  {\n    52→    \"id\": \"ACE-004\",\n    53→    \"title\": \"Strategy Generation Cron + API Route\",\n    54→    \"description\": \"Create /api/cron/strategy-generate and /api/v1/content/strategy/generate. Uses OpenAI (gpt-4o-mini) to analyze recent content_signals and generate a daily strategy brief. Output: primary_objective, secondary_objective, target_mix (pillar distribution), exclusions (avoid over-represented pillars/CTAs), notes. Writes to content_strategy_briefs table.\",\n    55→    \"category\": \"cron\",\n    56→    \"priority\": 1,\n    57→    \"passes\": false,\n    58→    \"status\": \"pending\",\n    59→    \"acceptance_criteria\": [\n    60→      \"GET /api/cron/strategy-generate returns {ok: true, brief_id: UUID}\",\n    61→      \"content_strategy_briefs row created with scope_type='daily', valid primary_objective\",\n    62→      \"target_mix is valid JSONB with pillar keys summing to ~1.0\",\n    63→      \"OpenAI call uses real API key from env (OPENAI_API_KEY)\",\n    64→      \"job_runs idempotency: second call same day returns existing brief_id\"\n    65→    ]\n    66→  },\n    67→  {\n    68→    \"id\": \"ACE-005\",\n    69→    \"title\": \"Candidate Generation Cron + API Route\",\n    70→    \"description\": \"Create /api/cron/candidates-generate and /api/v1/content/candidates/generate. Uses OpenAI to generate 20 post concept candidates from today's strategy brief. Each candidate has: pillar, subtopic, awareness_level, format, hook_type, cta_type, target_emotion, concept_text. Writes all 20 rows to content_candidates with status='generated'.\",\n    71→    \"category\": \"cron\",\n    72→    \"priority\": 1,\n    73→    \"passes\": false,\n    74→    \"status\": \"pending\",\n    75→    \"acceptance_criteria\": [\n    76→      \"GET /api/cron/candidates-generate returns {ok: true, count: 20, brief_id: UUID}\",\n    77→      \"20 content_candidates rows created linked to today's brief_id\",\n    78→      \"Each candidate has all required fields populated (no nulls on required cols)\",\n    79→      \"Format values are within allowed set (static_truth, carousel_psychology, etc.)\",\n    80→      \"Hook types and CTA types are within allowed sets\"\n    81→    ]\n    82→  },\n    83→  {\n    84→    \"id\": \"ACE-006\",\n    85→    \"title\": \"Candidate Scoring Cron + API Route\",\n    86→    \"description\": \"Create /api/cron/candidates-score and /api/v1/content/candidates/score. Scores all 'generated' candidates using the 7-component formula. Loads weights from model_weights (active row). Uses OpenAI to estimate predicted_engagement and predicted_conversion (0..1). Computes novelty_score via simple substring comparison against last 30 days of published concept_text. Sets total_score and status='scored'.\",\n    87→    \"category\": \"cron\",\n    88→    \"priority\": 2,\n    89→    \"passes\": false,\n    90→    \"status\": \"pending\",\n    91→    \"acceptance_criteria\": [\n    92→      \"GET /api/cron/candidates-score returns {ok: true, scored: N}\",\n    93→      \"All candidates have total_score set (not null)\",\n    94→      \"Scores are in range 0..1\",\n    95→      \"Weights loaded from model_weights active row, not hardcoded\",\n    96→      \"status updated to 'scored' for processed rows\"\n    97→    ]\n    98→  },\n    99→  {\n   100→    \"id\": \"ACE-007\",\n   101→    \"title\": \"Copy Generation — /api/v1/content/copy/generate\",\n   102→    \"description\": \"Create POST /api/v1/content/copy/generate and call it from /api/cron/copy-and-assets. Takes top 5 scored candidates (by total_score DESC). For each: calls OpenAI gpt-4o to generate caption (150-300 words), hook sentence, CTA line, alt_text. Writes to content_copy_variants with variant_type='primary'. Updates candidate status to 'copy_done'.\",\n   103→    \"category\": \"production\",\n   104→    \"priority\": 2,\n   105→    \"passes\": false,\n   106→    \"status\": \"pending\",\n   107→    \"acceptance_criteria\": [\n   108→      \"POST /api/v1/content/copy/generate accepts {brief_id?, limit?} and returns {ok: true, variants: [{candidate_id, variant_id}]}\",\n   109→      \"content_copy_variants rows created for top 5 candidates\",\n   110→      \"caption length 150-2200 chars\",\n   111→      \"OpenAI prompt references pillar, hook_type, cta_type from the candidate\",\n   112→      \"candidate status updated to 'copy_done'\"\n   113→    ]\n   114→  },\n   115→  {\n   116→    \"id\": \"ACE-008\",\n   117→    \"title\": \"Asset Rendering — /api/v1/content/assets/render\",\n   118→    \"description\": \"Create POST /api/v1/content/assets/render. For static_truth and founder_note formats: generates an HTML string using the caption/hook, renders to PNG via Playwright (headless), uploads to Supabase Storage bucket 'content-assets', writes public_url to content_assets table. For other formats: creates a render_spec JSONB with slide_copy or overlay_copy from the copy variant and sets render_status='spec_ready' (full Playwright render is Phase 2). Updates candidate status to 'assets_done'.\",\n   119→    \"category\": \"production\",\n   120→    \"priority\": 2,\n   121→    \"passes\": false,\n   122→    \"status\": \"pending\",\n   123→    \"acceptance_criteria\": [\n   124→      \"POST /api/v1/content/assets/render returns {ok: true, rendered: N, specs: M}\",\n   125→      \"static_truth format: Playwright PNG render → Supabase Storage → public_url set in content_assets\",\n   126→      \"Other formats: render_spec JSONB populated, render_status='spec_ready'\",\n   127→      \"content_assets rows linked to correct candidate_id and template_id\",\n   128→      \"Supabase Storage bucket 'content-assets' exists (create if not)\"\n   129→    ]\n   130→  },\n   131→  {\n   132→    \"id\": \"ACE-009\",\n   133→    \"title\": \"QA Gate — /api/v1/content/qa/run\",\n   134→    \"description\": \"Create POST /api/v1/content/qa/run and include in /api/cron/qa-and-queue-fill. Runs all hard-rejection rules against candidates with status='assets_done': duplicate concept check (30 days), duplicate hook wording (14 days), pillar frequency (last 5 posts), CTA frequency (last 5 posts), caption present, asset present, caption length. Sets candidate status to 'approved' or 'rejected' with rejection_reason in metadata.\",\n   135→    \"category\": \"production\",\n   136→    \"priority\": 2,\n   137→    \"passes\": false,\n   138→    \"status\": \"pending\",\n   139→    \"acceptance_criteria\": [\n   140→      \"POST /api/v1/content/qa/run returns {ok: true, approved: N, rejected: M, reasons: [...]}\",\n   141→      \"Candidates without assets are rejected with reason 'no_asset'\",\n   142→      \"Candidates with captions < 50 chars rejected with reason 'caption_too_short'\",\n   143→      \"status field correctly set to 'approved' or 'rejected' on each candidate\",\n   144→      \"rejection_reason stored in metadata JSONB\"\n   145→    ]\n   146→  },\n   147→  {\n   148→    \"id\": \"ACE-010\",\n   149→    \"title\": \"Queue Fill — /api/v1/content/queue/fill\",\n   150→    \"description\": \"Create POST /api/v1/content/queue/fill. Checks current count of queued posts in post_queue (queue_status='queued'). If below 7 (minimum backlog), picks top approved candidates by total_score and submits them to the existing instagram_post_queue via POST /api/v1/integrations/instagram/queue. Sets dedupe_key as 'instagram:{candidate_id}:{template_version}'. Updates post_queue row status to 'queued'. Returns queue depth.\",\n   151→    \"category\": \"queue\",\n   152→    \"priority\": 2,\n   153→    \"passes\": false,\n   154→    \"status\": \"pending\",\n   155→    \"acceptance_criteria\": [\n   156→      \"POST /api/v1/content/queue/fill returns {ok: true, added: N, queue_depth: M}\",\n   157→      \"Does not add duplicates (dedupe_key UNIQUE enforced)\",\n   158→      \"Only submits candidates with status='approved' and assets\",\n   159→      \"Calls existing /api/v1/integrations/instagram/queue internally — does not bypass it\",\n   160→      \"post_queue rows linked to correct candidate_id\"\n   161→    ]\n   162→  },\n   163→  {\n   164→    \"id\": \"ACE-011\",\n   165→    \"title\": \"Copy-and-Assets Cron Route\",\n   166→    \"description\": \"Create GET /api/cron/copy-and-assets that chains: (1) copy generation for top 5 scored candidates, (2) asset rendering for copy_done candidates, in sequence. Uses job_runs for idempotency. Returns summary of what was produced.\",\n   167→    \"category\": \"cron\",\n   168→    \"priority\": 2,\n   169→    \"passes\": false,\n   170→    \"status\": \"pending\",\n   171→    \"acceptance_criteria\": [\n   172→      \"GET /api/cron/copy-and-assets returns {ok: true, copy_generated: N, assets_rendered: M}\",\n   173→      \"job_runs idempotency prevents double-running same day\",\n   174→      \"If copy already done for today, skips copy step\",\n   175→      \"If assets already done for today, skips asset step\",\n   176→      \"Returns 200 not 500 on success\"\n   177→    ]\n   178→  },\n   179→  {\n   180→    \"id\": \"ACE-012\",\n   181→    \"title\": \"QA-and-Queue-Fill Cron Route\",\n   182→    \"description\": \"Create GET /api/cron/qa-and-queue-fill that chains: (1) QA run, (2) queue fill if backlog < 7. Uses job_runs idempotency. Returns QA results and final queue depth.\",\n   183→    \"category\": \"cron\",\n   184→    \"priority\": 2,\n   185→    \"passes\": false,\n   186→    \"status\": \"pending\",\n   187→    \"acceptance_criteria\": [\n   188→      \"GET /api/cron/qa-and-queue-fill returns {ok: true, approved: N, rejected: M, queue_depth: K}\",\n   189→      \"job_runs prevents double-run same day\",\n   190→      \"Queue fill only triggered if depth < 7\",\n   191→      \"Returns 200 not 500\"\n   192→    ]\n   193→  },\n   194→  {\n   195→    \"id\": \"ACE-013\",\n   196→    \"title\": \"Performance Sync — /api/v1/content/performance/sync\",\n   197→    \"description\": \"Create POST /api/v1/content/performance/sync and wire it into /api/cron/content-model-update. Reads from instagram_post_performance (existing table), matches to post_queue rows via platform_post_id, then to content_candidates. Writes to post_performance table. Computes engagement_score = (likes + comments*3 + saves*5 + shares*7) / reach, normalized. Computes conversion_score from profile_visits / reach.\",\n   198→    \"category\": \"learning\",\n   199→    \"priority\": 3,\n   200→    \"passes\": false,\n   201→    \"status\": \"pending\",\n   202→    \"acceptance_criteria\": [\n   203→      \"POST /api/v1/content/performance/sync returns {ok: true, synced: N}\",\n   204→      \"post_performance rows created with engagement_score and conversion_score computed\",\n   205→      \"Correctly matches instagram_post_performance → post_queue → content_candidates\",\n   206→      \"Does not create duplicate rows (UNIQUE on published_post_id enforced)\",\n   207→      \"Returns 200 with count\"\n   208→    ]\n   209→  },\n   210→  {\n   211→    \"id\": \"ACE-014\",\n   212→    \"title\": \"Model Weight Updater — /api/v1/content/model/update\",\n   213→    \"description\": \"Create POST /api/v1/content/model/update and include in /api/cron/content-model-update. Analyzes last 30 days of post_performance linked to candidates. Uses simple correlation: for each of the 7 scoring components, compute correlation with actual engagement_score. Adjusts weights proportionally (normalize so they still sum to 1.0). Writes new model_weights row with is_active=true, deactivates previous active row.\",\n   214→    \"category\": \"learning\",\n   215→    \"priority\": 3,\n   216→    \"passes\": false,\n   217→    \"status\": \"pending\",\n   218→    \"acceptance_criteria\": [\n   219→      \"POST /api/v1/content/model/update returns {ok: true, new_weights: {...}, previous_weights: {...}}\",\n   220→      \"New model_weights row created with is_active=true\",\n   221→      \"Previous active row set to is_active=false\",\n   222→      \"New weights sum to 1.0 (within 0.001 tolerance)\",\n   223→      \"Gracefully handles case of < 10 data points (returns default weights unchanged)\"\n   224→    ]\n   225→  },\n   226→  {\n   227→    \"id\": \"ACE-015\",\n   228→    \"title\": \"Content Model Update Cron Route\",\n   229→    \"description\": \"Create GET /api/cron/content-model-update that chains: (1) performance sync, (2) model weight update. Runs daily at 4:20am UTC. Uses job_runs idempotency.\",\n   230→    \"category\": \"cron\",\n   231→    \"priority\": 3,\n   232→    \"passes\": false,\n   233→    \"status\": \"pending\",\n   234→    \"acceptance_criteria\": [\n   235→      \"GET /api/cron/content-model-update returns {ok: true, synced: N, weights_updated: bool}\",\n   236→      \"job_runs prevents double-run same day\",\n   237→      \"Returns 200 not 500\"\n   238→    ]\n   239→  },\n   240→  {\n   241→    \"id\": \"ACE-016\",\n   242→    \"title\": \"Dashboard API — /api/v1/content/dashboard\",\n   243→    \"description\": \"Create GET /api/v1/content/dashboard. Returns: (1) queue_depth (count of queued posts), (2) today_brief (today's strategy brief summary), (3) top_candidates (top 5 scored candidates with scores), (4) recent_performance (last 7 posts with engagement_score, pillar, format), (5) model_weights (current active weights), (6) pipeline_status (last run time of each cron job from job_runs).\",\n   244→    \"category\": \"observability\",\n   245→    \"priority\": 3,\n   246→    \"passes\": false,\n   247→    \"status\": \"pending\",\n   248→    \"acceptance_criteria\": [\n   249→      \"GET /api/v1/content/dashboard returns valid JSON with all 6 sections\",\n   250→      \"queue_depth is integer >= 0\",\n   251→      \"pipeline_status shows last completed_at for each of the 7 cron jobs\",\n   252→      \"Returns 200 even if some sections have empty arrays\",\n   253→      \"Response time < 3 seconds\"\n   254→    ]\n   255→  },\n   256→  {\n   257→    \"id\": \"ACE-017\",\n   258→    \"title\": \"Health Endpoint\",\n   259→    \"description\": \"Ensure GET /api/health (already exists) returns content engine status in its response, or create /api/v1/content/health that checks: Supabase connectivity, OpenAI API key present, content_templates count > 0, model_weights active row exists.\",\n   260→    \"category\": \"observability\",\n   261→    \"priority\": 1,\n   262→    \"passes\": false,\n   263→    \"status\": \"pending\",\n   264→    \"acceptance_criteria\": [\n   265→      \"GET /api/v1/content/health returns {ok: true, supabase: 'connected', openai_key: 'present', templates: N, model_weights: 'active'}\",\n   266→      \"Returns 200 when healthy, 503 when unhealthy\",\n   267→      \"Supabase check does a real SELECT COUNT(*) from content_templates\"\n   268→    ]\n   269→  },\n   270→  {\n   271→    \"id\": \"ACE-018\",\n   272→    \"title\": \"Evergreen Fallback Posts\",\n   273→    \"description\": \"Seed 15 evergreen pre-approved posts in post_queue (queue_status='queued', queue_source='evergreen_seed'). These cover all 8 pillars, static_truth format, with real captions about friendship fading, adult social anxiety, relationship systems. These serve as the fallback when autonomous engine hasn't run yet.\",\n   274→    \"category\": \"queue\",\n   275→    \"priority\": 1,\n   276→    \"passes\": false,\n   277→    \"status\": \"pending\",\n   278→    \"acceptance_criteria\": [\n   279→      \"15 rows in post_queue with queue_status='queued' and queue_source='evergreen_seed'\",\n   280→      \"Each row has a real caption (not placeholder text)\",\n   281→      \"Covers at least 5 different pillars\",\n   282→      \"All captions 100-500 chars\",\n   283→      \"auto_schedule=true on all rows\"\n   284→    ]\n   285→  },\n   286→  {\n   287→    \"id\": \"ACE-019\",\n   288→    \"title\": \"End-to-End Pipeline Test\",\n   289→    \"description\": \"Create a test script at /scripts/test-content-pipeline.ts (or .js) that calls each API endpoint in order: health → signals/sync → strategy/generate → candidates/generate → candidates/score → copy/generate → assets/render → qa/run → queue/fill → dashboard. Prints pass/fail for each step. Uses real Supabase and real OpenAI — no mocks.\",\n   290→    \"category\": \"testing\",\n   291→    \"priority\": 3,\n   292→    \"passes\": false,\n   293→    \"status\": \"pending\",\n   294→    \"acceptance_criteria\": [\n   295→      \"Script runs without crashing: npx ts-node scripts/test-content-pipeline.ts\",\n   296→      \"Each step prints PASS or FAIL with HTTP status\",\n   297→      \"At end: prints total PASSED/FAILED count\",\n   298→      \"If any step returns 500, prints the error body\",\n   299→      \"Script exits 0 if all pass, 1 if any fail\"\n   300→    ]\n   301→  },\n   302→  {\n   303→    \"id\": \"ACE-020\",\n   304→    \"title\": \"Deploy to Vercel Production\",\n   305→    \"description\": \"Run `npx vercel --yes --prod` from /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel. Verify the deployment URL is accessible. Confirm /api/v1/content/health returns 200 on the production URL.\",\n   306→    \"category\": \"deployment\",\n   307→    \"priority\": 3,\n   308→    \"passes\": false,\n   309→    \"status\": \"pending\",\n   310→    \"acceptance_criteria\": [\n   311→      \"vercel --prod completes without error\",\n   312→      \"Production URL returns 200 on /api/v1/content/health\",\n   313→      \"All 7 new cron routes appear in vercel.json and are deployed\",\n   314→      \"Deployment URL logged to console\"\n   315→    ]\n   316→  }\n   317→  ]\n   318→}\n   319→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3ca29b94-4e19-4a86-9fa5-c871da6b8f97","uuid":"8aad4897-be27-43cc-b790-41f28dac8830","tool_use_result":{"type":"text","file":{"filePath":"/Users/isaiahdupree/Documents/Software/autonomous-coding-dashboard/harness/everreach-autonomous-content-engine-features.json","content":"{\n  \"project\": \"everreach-autonomous-content-engine\",\n  \"version\": \"1.0.0\",\n  \"description\": \"20 features: Supabase schema, 7 cron routes, copy/asset/QA pipeline, learning loop, dashboard, evergreen seed posts, E2E test, Vercel deploy\",\n  \"features\": [\n  {\n    \"id\": \"ACE-001\",\n    \"title\": \"Database Schema Migration\",\n    \"description\": \"Apply all 11 Supabase table migrations via mcp__supabase__apply_migration: content_signals, content_strategy_briefs, content_candidates, content_copy_variants, content_templates, content_assets, post_queue, published_posts, post_performance, model_weights, job_runs. Seed model_weights with default scoring weights and content_templates with 5 initial template records.\",\n    \"category\": \"infrastructure\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"All 11 tables exist in Supabase\",\n      \"model_weights has 1 active row with correct 7 weight fields\",\n      \"content_templates has 5 seed rows (static_truth_v1, carousel_psychology_v1, carousel_framework_v1, product_screenshot_v1, founder_note_v1)\",\n      \"job_runs has UNIQUE constraint on (job_name, run_key)\"\n    ]\n  },\n  {\n    \"id\": \"ACE-002\",\n    \"title\": \"vercel.json Cron Additions\",\n    \"description\": \"Add 7 new cron entries to /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel/vercel.json for the content engine pipeline. Preserve all existing cron entries.\",\n    \"category\": \"infrastructure\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"vercel.json has 7 new cron paths: /api/cron/signals-sync, strategy-generate, candidates-generate, candidates-score, copy-and-assets, qa-and-queue-fill, content-model-update\",\n      \"All existing crons (instagram-publisher, instagram-engagement-sync, etc.) are preserved\",\n      \"File is valid JSON\"\n    ]\n  },\n  {\n    \"id\": \"ACE-003\",\n    \"title\": \"Signals Sync Cron + API Route\",\n    \"description\": \"Create /api/cron/signals-sync and /api/v1/content/signals/sync. The job ingests signals from: (1) instagram_post_performance — tag top posts by pillar/format, (2) a static seed of 10 evergreen app-store review signals. Uses job_runs for idempotency with run_key = date. Writes rows to content_signals table.\",\n    \"category\": \"cron\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/signals-sync returns {ok: true, inserted: N}\",\n      \"POST /api/v1/content/signals/sync works with same logic\",\n      \"job_runs deduplication prevents re-running same day\",\n      \"content_signals rows have source_type, signal_category, signal_text populated\",\n      \"Returns 200 with metadata, not 500\"\n    ]\n  },\n  {\n    \"id\": \"ACE-004\",\n    \"title\": \"Strategy Generation Cron + API Route\",\n    \"description\": \"Create /api/cron/strategy-generate and /api/v1/content/strategy/generate. Uses OpenAI (gpt-4o-mini) to analyze recent content_signals and generate a daily strategy brief. Output: primary_objective, secondary_objective, target_mix (pillar distribution), exclusions (avoid over-represented pillars/CTAs), notes. Writes to content_strategy_briefs table.\",\n    \"category\": \"cron\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/strategy-generate returns {ok: true, brief_id: UUID}\",\n      \"content_strategy_briefs row created with scope_type='daily', valid primary_objective\",\n      \"target_mix is valid JSONB with pillar keys summing to ~1.0\",\n      \"OpenAI call uses real API key from env (OPENAI_API_KEY)\",\n      \"job_runs idempotency: second call same day returns existing brief_id\"\n    ]\n  },\n  {\n    \"id\": \"ACE-005\",\n    \"title\": \"Candidate Generation Cron + API Route\",\n    \"description\": \"Create /api/cron/candidates-generate and /api/v1/content/candidates/generate. Uses OpenAI to generate 20 post concept candidates from today's strategy brief. Each candidate has: pillar, subtopic, awareness_level, format, hook_type, cta_type, target_emotion, concept_text. Writes all 20 rows to content_candidates with status='generated'.\",\n    \"category\": \"cron\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/candidates-generate returns {ok: true, count: 20, brief_id: UUID}\",\n      \"20 content_candidates rows created linked to today's brief_id\",\n      \"Each candidate has all required fields populated (no nulls on required cols)\",\n      \"Format values are within allowed set (static_truth, carousel_psychology, etc.)\",\n      \"Hook types and CTA types are within allowed sets\"\n    ]\n  },\n  {\n    \"id\": \"ACE-006\",\n    \"title\": \"Candidate Scoring Cron + API Route\",\n    \"description\": \"Create /api/cron/candidates-score and /api/v1/content/candidates/score. Scores all 'generated' candidates using the 7-component formula. Loads weights from model_weights (active row). Uses OpenAI to estimate predicted_engagement and predicted_conversion (0..1). Computes novelty_score via simple substring comparison against last 30 days of published concept_text. Sets total_score and status='scored'.\",\n    \"category\": \"cron\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/candidates-score returns {ok: true, scored: N}\",\n      \"All candidates have total_score set (not null)\",\n      \"Scores are in range 0..1\",\n      \"Weights loaded from model_weights active row, not hardcoded\",\n      \"status updated to 'scored' for processed rows\"\n    ]\n  },\n  {\n    \"id\": \"ACE-007\",\n    \"title\": \"Copy Generation — /api/v1/content/copy/generate\",\n    \"description\": \"Create POST /api/v1/content/copy/generate and call it from /api/cron/copy-and-assets. Takes top 5 scored candidates (by total_score DESC). For each: calls OpenAI gpt-4o to generate caption (150-300 words), hook sentence, CTA line, alt_text. Writes to content_copy_variants with variant_type='primary'. Updates candidate status to 'copy_done'.\",\n    \"category\": \"production\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/copy/generate accepts {brief_id?, limit?} and returns {ok: true, variants: [{candidate_id, variant_id}]}\",\n      \"content_copy_variants rows created for top 5 candidates\",\n      \"caption length 150-2200 chars\",\n      \"OpenAI prompt references pillar, hook_type, cta_type from the candidate\",\n      \"candidate status updated to 'copy_done'\"\n    ]\n  },\n  {\n    \"id\": \"ACE-008\",\n    \"title\": \"Asset Rendering — /api/v1/content/assets/render\",\n    \"description\": \"Create POST /api/v1/content/assets/render. For static_truth and founder_note formats: generates an HTML string using the caption/hook, renders to PNG via Playwright (headless), uploads to Supabase Storage bucket 'content-assets', writes public_url to content_assets table. For other formats: creates a render_spec JSONB with slide_copy or overlay_copy from the copy variant and sets render_status='spec_ready' (full Playwright render is Phase 2). Updates candidate status to 'assets_done'.\",\n    \"category\": \"production\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/assets/render returns {ok: true, rendered: N, specs: M}\",\n      \"static_truth format: Playwright PNG render → Supabase Storage → public_url set in content_assets\",\n      \"Other formats: render_spec JSONB populated, render_status='spec_ready'\",\n      \"content_assets rows linked to correct candidate_id and template_id\",\n      \"Supabase Storage bucket 'content-assets' exists (create if not)\"\n    ]\n  },\n  {\n    \"id\": \"ACE-009\",\n    \"title\": \"QA Gate — /api/v1/content/qa/run\",\n    \"description\": \"Create POST /api/v1/content/qa/run and include in /api/cron/qa-and-queue-fill. Runs all hard-rejection rules against candidates with status='assets_done': duplicate concept check (30 days), duplicate hook wording (14 days), pillar frequency (last 5 posts), CTA frequency (last 5 posts), caption present, asset present, caption length. Sets candidate status to 'approved' or 'rejected' with rejection_reason in metadata.\",\n    \"category\": \"production\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/qa/run returns {ok: true, approved: N, rejected: M, reasons: [...]}\",\n      \"Candidates without assets are rejected with reason 'no_asset'\",\n      \"Candidates with captions < 50 chars rejected with reason 'caption_too_short'\",\n      \"status field correctly set to 'approved' or 'rejected' on each candidate\",\n      \"rejection_reason stored in metadata JSONB\"\n    ]\n  },\n  {\n    \"id\": \"ACE-010\",\n    \"title\": \"Queue Fill — /api/v1/content/queue/fill\",\n    \"description\": \"Create POST /api/v1/content/queue/fill. Checks current count of queued posts in post_queue (queue_status='queued'). If below 7 (minimum backlog), picks top approved candidates by total_score and submits them to the existing instagram_post_queue via POST /api/v1/integrations/instagram/queue. Sets dedupe_key as 'instagram:{candidate_id}:{template_version}'. Updates post_queue row status to 'queued'. Returns queue depth.\",\n    \"category\": \"queue\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/queue/fill returns {ok: true, added: N, queue_depth: M}\",\n      \"Does not add duplicates (dedupe_key UNIQUE enforced)\",\n      \"Only submits candidates with status='approved' and assets\",\n      \"Calls existing /api/v1/integrations/instagram/queue internally — does not bypass it\",\n      \"post_queue rows linked to correct candidate_id\"\n    ]\n  },\n  {\n    \"id\": \"ACE-011\",\n    \"title\": \"Copy-and-Assets Cron Route\",\n    \"description\": \"Create GET /api/cron/copy-and-assets that chains: (1) copy generation for top 5 scored candidates, (2) asset rendering for copy_done candidates, in sequence. Uses job_runs for idempotency. Returns summary of what was produced.\",\n    \"category\": \"cron\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/copy-and-assets returns {ok: true, copy_generated: N, assets_rendered: M}\",\n      \"job_runs idempotency prevents double-running same day\",\n      \"If copy already done for today, skips copy step\",\n      \"If assets already done for today, skips asset step\",\n      \"Returns 200 not 500 on success\"\n    ]\n  },\n  {\n    \"id\": \"ACE-012\",\n    \"title\": \"QA-and-Queue-Fill Cron Route\",\n    \"description\": \"Create GET /api/cron/qa-and-queue-fill that chains: (1) QA run, (2) queue fill if backlog < 7. Uses job_runs idempotency. Returns QA results and final queue depth.\",\n    \"category\": \"cron\",\n    \"priority\": 2,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/qa-and-queue-fill returns {ok: true, approved: N, rejected: M, queue_depth: K}\",\n      \"job_runs prevents double-run same day\",\n      \"Queue fill only triggered if depth < 7\",\n      \"Returns 200 not 500\"\n    ]\n  },\n  {\n    \"id\": \"ACE-013\",\n    \"title\": \"Performance Sync — /api/v1/content/performance/sync\",\n    \"description\": \"Create POST /api/v1/content/performance/sync and wire it into /api/cron/content-model-update. Reads from instagram_post_performance (existing table), matches to post_queue rows via platform_post_id, then to content_candidates. Writes to post_performance table. Computes engagement_score = (likes + comments*3 + saves*5 + shares*7) / reach, normalized. Computes conversion_score from profile_visits / reach.\",\n    \"category\": \"learning\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/performance/sync returns {ok: true, synced: N}\",\n      \"post_performance rows created with engagement_score and conversion_score computed\",\n      \"Correctly matches instagram_post_performance → post_queue → content_candidates\",\n      \"Does not create duplicate rows (UNIQUE on published_post_id enforced)\",\n      \"Returns 200 with count\"\n    ]\n  },\n  {\n    \"id\": \"ACE-014\",\n    \"title\": \"Model Weight Updater — /api/v1/content/model/update\",\n    \"description\": \"Create POST /api/v1/content/model/update and include in /api/cron/content-model-update. Analyzes last 30 days of post_performance linked to candidates. Uses simple correlation: for each of the 7 scoring components, compute correlation with actual engagement_score. Adjusts weights proportionally (normalize so they still sum to 1.0). Writes new model_weights row with is_active=true, deactivates previous active row.\",\n    \"category\": \"learning\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"POST /api/v1/content/model/update returns {ok: true, new_weights: {...}, previous_weights: {...}}\",\n      \"New model_weights row created with is_active=true\",\n      \"Previous active row set to is_active=false\",\n      \"New weights sum to 1.0 (within 0.001 tolerance)\",\n      \"Gracefully handles case of < 10 data points (returns default weights unchanged)\"\n    ]\n  },\n  {\n    \"id\": \"ACE-015\",\n    \"title\": \"Content Model Update Cron Route\",\n    \"description\": \"Create GET /api/cron/content-model-update that chains: (1) performance sync, (2) model weight update. Runs daily at 4:20am UTC. Uses job_runs idempotency.\",\n    \"category\": \"cron\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/cron/content-model-update returns {ok: true, synced: N, weights_updated: bool}\",\n      \"job_runs prevents double-run same day\",\n      \"Returns 200 not 500\"\n    ]\n  },\n  {\n    \"id\": \"ACE-016\",\n    \"title\": \"Dashboard API — /api/v1/content/dashboard\",\n    \"description\": \"Create GET /api/v1/content/dashboard. Returns: (1) queue_depth (count of queued posts), (2) today_brief (today's strategy brief summary), (3) top_candidates (top 5 scored candidates with scores), (4) recent_performance (last 7 posts with engagement_score, pillar, format), (5) model_weights (current active weights), (6) pipeline_status (last run time of each cron job from job_runs).\",\n    \"category\": \"observability\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/v1/content/dashboard returns valid JSON with all 6 sections\",\n      \"queue_depth is integer >= 0\",\n      \"pipeline_status shows last completed_at for each of the 7 cron jobs\",\n      \"Returns 200 even if some sections have empty arrays\",\n      \"Response time < 3 seconds\"\n    ]\n  },\n  {\n    \"id\": \"ACE-017\",\n    \"title\": \"Health Endpoint\",\n    \"description\": \"Ensure GET /api/health (already exists) returns content engine status in its response, or create /api/v1/content/health that checks: Supabase connectivity, OpenAI API key present, content_templates count > 0, model_weights active row exists.\",\n    \"category\": \"observability\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"GET /api/v1/content/health returns {ok: true, supabase: 'connected', openai_key: 'present', templates: N, model_weights: 'active'}\",\n      \"Returns 200 when healthy, 503 when unhealthy\",\n      \"Supabase check does a real SELECT COUNT(*) from content_templates\"\n    ]\n  },\n  {\n    \"id\": \"ACE-018\",\n    \"title\": \"Evergreen Fallback Posts\",\n    \"description\": \"Seed 15 evergreen pre-approved posts in post_queue (queue_status='queued', queue_source='evergreen_seed'). These cover all 8 pillars, static_truth format, with real captions about friendship fading, adult social anxiety, relationship systems. These serve as the fallback when autonomous engine hasn't run yet.\",\n    \"category\": \"queue\",\n    \"priority\": 1,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"15 rows in post_queue with queue_status='queued' and queue_source='evergreen_seed'\",\n      \"Each row has a real caption (not placeholder text)\",\n      \"Covers at least 5 different pillars\",\n      \"All captions 100-500 chars\",\n      \"auto_schedule=true on all rows\"\n    ]\n  },\n  {\n    \"id\": \"ACE-019\",\n    \"title\": \"End-to-End Pipeline Test\",\n    \"description\": \"Create a test script at /scripts/test-content-pipeline.ts (or .js) that calls each API endpoint in order: health → signals/sync → strategy/generate → candidates/generate → candidates/score → copy/generate → assets/render → qa/run → queue/fill → dashboard. Prints pass/fail for each step. Uses real Supabase and real OpenAI — no mocks.\",\n    \"category\": \"testing\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"Script runs without crashing: npx ts-node scripts/test-content-pipeline.ts\",\n      \"Each step prints PASS or FAIL with HTTP status\",\n      \"At end: prints total PASSED/FAILED count\",\n      \"If any step returns 500, prints the error body\",\n      \"Script exits 0 if all pass, 1 if any fail\"\n    ]\n  },\n  {\n    \"id\": \"ACE-020\",\n    \"title\": \"Deploy to Vercel Production\",\n    \"description\": \"Run `npx vercel --yes --prod` from /Users/isaiahdupree/Documents/Software/EverReachOrganized/backend/backend-vercel. Verify the deployment URL is accessible. Confirm /api/v1/content/health returns 200 on the production URL.\",\n    \"category\": \"deployment\",\n    \"priority\": 3,\n    \"passes\": false,\n    \"status\": \"pending\",\n    \"acceptance_criteria\": [\n      \"vercel --prod completes without error\",\n      \"Production URL returns 200 on /api/v1/content/health\",\n      \"All 7 new cron routes appear in vercel.json and are deployed\",\n      \"Deployment URL logged to console\"\n    ]\n  }\n  ]\n}\n","numLines":319,"startLine":1,"totalLines":319}}}
