# EverReach primary auth/app data remains configured by SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY. These explicit variables select the isolated
# shared-project owned-attribution data plane; there is intentionally no
# fallback to the primary project.
OWNED_OUTCOME_SUPABASE_URL=https://your-shared-project.supabase.co
OWNED_OUTCOME_SUPABASE_SERVICE_ROLE_KEY=your_shared_project_service_role_key

# Publication registration and anonymous touch issuance fail closed until both
# credentials are configured in the deployment secret store.
ATTRIBUTION_PUBLICATION_CONTROL_TOKEN=your_publication_control_token
ATTRIBUTION_CLAIM_SIGNING_SECRET=your_claim_signing_secret

# Required only by the authenticated retention ingestion endpoint.
OWNED_RETENTION_INGEST_TOKEN=your_retention_ingest_token

# Bounded local delivery bridge.
CONTENT_QUALITY_URL=http://127.0.0.1:6010
CONTENT_QUALITY_CONTROL_TOKEN=your_content_quality_control_token
OWNED_OUTCOME_BRIDGE_STATE_DB=/absolute/private/path/owned-outcome-bridge.sqlite3
OWNED_OUTCOME_RUN_STATUS_FILE=/absolute/private/path/owned-outcome-last-run.json

# Optional measured-retention source. A phc_ project key is not a personal
# query credential; use a phx_ personal key with POSTHOG_PROJECT_ID.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_QUERY_HOST=https://us.posthog.com
